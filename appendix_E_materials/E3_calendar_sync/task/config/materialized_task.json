{
  "id": "al_calendar_schedule_conflict",
  "instruction": "This week's meeting schedule has conflicts: Android Simple Calendar Pro and Linux `/tmp/schedule/week.csv` disagree on details for meetings with the same names. Follow `/tmp/schedule/rule.txt`: synchronize each matching meeting's date, start, end, and location from Android, leave non-matching meetings unchanged, then write `/tmp/schedule/log.json` with every field that changed and its old and new values.",
  "devices": [
    {
      "id": "android_0",
      "type": "android"
    },
    {
      "id": "linux_0",
      "type": "linux"
    }
  ],
  "variables": {
    "week_csv": "/tmp/schedule/week.csv",
    "log_json": "/tmp/schedule/log.json"
  },
  "setup": [
    {
      "device_id": "android_0",
      "config": [
        {
          "type": "ensure_app",
          "parameters": {
            "app": "simple calendar pro"
          }
        },
        {
          "type": "androidworld_calendar_clear",
          "parameters": {}
        },
        {
          "type": "androidworld_calendar_event_add",
          "parameters": {
            "title": "Vendor planning",
            "start_ts": 1802530800,
            "end_ts": 1802534400,
            "location": "Room 8",
            "description": "Source of truth for schedule correction"
          }
        }
      ]
    },
    {
      "device_id": "linux_0",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "rm -rf /tmp/schedule && mkdir -p /tmp/schedule",
            "shell": true
          }
        },
        {
          "type": "upload_file",
          "parameters": {
            "files": [
              {
                "local_path": "/Users/Admin/home/MDC_Benchmark_lite_ufo3/worker-worktrees/ufo3-gpt55-core200-rerun-20260826/tasks/cross_device/real100_assets/al_calendar_schedule_conflict/source/week.csv",
                "path": "/tmp/schedule/week.csv"
              },
              {
                "local_path": "/Users/Admin/home/MDC_Benchmark_lite_ufo3/worker-worktrees/ufo3-gpt55-core200-rerun-20260826/tasks/cross_device/real100_assets/al_calendar_schedule_conflict/source/rule.txt",
                "path": "/tmp/schedule/rule.txt"
              }
            ]
          }
        },
        {
          "type": "execute",
          "parameters": {
            "command": "test -r /tmp/schedule/week.csv && test -w /tmp/schedule/week.csv && test -r /tmp/schedule/rule.txt && test -w /tmp/schedule && test ! -e /tmp/schedule/log.json",
            "shell": true
          }
        }
      ]
    }
  ],
  "cleanup": [
    {
      "device_id": "android_0",
      "config": [
        {
          "type": "androidworld_calendar_clear",
          "parameters": {}
        }
      ]
    },
    {
      "device_id": "linux_0",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "rm -rf /tmp/schedule",
            "shell": true
          }
        }
      ]
    }
  ],
  "evaluation": [
