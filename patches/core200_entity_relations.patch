+        try:
+            latitude = float(match.group(1))
+            longitude = float(match.group(2))
+        except ValueError:
+            return False
+        if (
+            abs(latitude - contract["latitude"]) > contract["tolerance"]
+            or abs(longitude - contract["longitude"]) > contract["tolerance"]
+        ):
+            return False
+    return True
+
