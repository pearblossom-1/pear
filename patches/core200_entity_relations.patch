+                for anchor in anchors
+                for match in _phrase_pattern(anchor).finditer(text)
+            }
+        )
+        if not anchor_spans and not parsed_transition_symbols:
+            return False
+        parsed.append(
+            {
+                "latitude": float(latitude),
+                "longitude": float(longitude),
+                "tolerance": float(tolerance),
+                "max_gap": max_gap,
+                "include_historical": include_historical,
+                "anchor_values": anchors,
+                "anchors": anchor_spans,
+                "pairs": [],
+            }
+        )
+
+    coordinate_matches = list(_COORDINATE_PAIR.finditer(text))
+    has_transition_chain = (
+        bool(parsed_transition_symbols)
+        and len(coordinate_matches) == len(parsed)
+        and all(
+            any(
+                symbol in text[left.end() : right.start()]
+                for symbol in parsed_transition_symbols
+            )
+            for left, right in zip(
+                coordinate_matches,
+                coordinate_matches[1:],
+                strict=False,
+            )
+        )
+    )
+    if has_transition_chain:
+        return _matches_ordered_coordinate_transition(
+            text,
+            parsed,
+            parsed_transition_symbols,
+        )
+    if parsed_transition_symbols and any(
+        not contract["anchors"] for contract in parsed
+    ):
+        return False
+
+    table_owners = _coordinate_table_owners(text, parsed)
+    for match in coordinate_matches:
+        try:
+            pair = (float(match.group(1)), float(match.group(2)))
+        except ValueError:
+            return False
+        owner = table_owners.get(match.span())
+        if owner is None:
+            clause_start, clause_end = _coordinate_clause_bounds(
+                text,
+                match.start(),
+                match.end(),
+            )
+            candidate_anchors = [
+                [
+                    span
+                    for span in contract["anchors"]
+                    if clause_start <= span[0] and span[1] <= clause_end
+                ]
+                for contract in parsed
+            ]
+            if not any(candidate_anchors):
+                candidate_anchors = [contract["anchors"] for contract in parsed]
+            distances: list[tuple[int, int] | None] = []
+            for anchors in candidate_anchors:
+                if not anchors:
+                    distances.append(None)
+                    continue
+                distances.append(
+                    min(
+                        (
+                            max(anchor_start - match.end(), match.start() - anchor_end, 0),
+                            0 if anchor_end <= match.start() else 1,
+                        )
+                        for anchor_start, anchor_end in anchors
+                    )
+                )
+            nearest = min(distance for distance in distances if distance is not None)
+            if nearest[0] > max(contract["max_gap"] for contract in parsed):
+                continue
+            owners = [index for index, distance in enumerate(distances) if distance == nearest]
+            if len(owners) != 1 or nearest[0] > parsed[owners[0]]["max_gap"]:
+                return False
+            owner = owners[0]
+        if (
+            parsed[owner]["include_historical"]
+            or not _coordinate_pair_is_historical(text, match.start(), match.end())
+        ):
+            parsed[owner]["pairs"].append(pair)
+
+    for contract in parsed:
+        pairs = contract["pairs"]
+        if not pairs or any(
+            abs(latitude - contract["latitude"]) > contract["tolerance"]
+            or abs(longitude - contract["longitude"]) > contract["tolerance"]
+            for latitude, longitude in pairs
+        ):
+            return False
+    return True
+
+
+def _matches_ordered_coordinate_transition(
+    text: str,
+    contracts: list[dict[str, Any]],
+    transition_symbols: list[str],
+) -> bool:
+    matches = list(_COORDINATE_PAIR.finditer(text))
+    if len(matches) != len(contracts):
+        return False
+    if any(
+        not any(
+            symbol in text[left.end() : right.start()]
+            for symbol in transition_symbols
+        )
+        for left, right in zip(matches, matches[1:], strict=False)
+    ):
+        return False
