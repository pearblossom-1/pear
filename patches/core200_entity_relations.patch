+def _semantic_alternatives_valid(value: Any) -> bool:
+    values = value if isinstance(value, list) else [value]
+    return (
+        1 <= len(values) <= 100
+        and all(isinstance(item, str) and bool(_normalize(item)) for item in values)
+    )
+
+
+def _semantic_label_binds_expected(
+    text: str,
+    label_span: tuple[int, int],
+    expected_spans: list[tuple[int, int]],
+    competing_spans: list[tuple[int, int]],
+) -> bool:
+    expected_distance = _nearest_span_distance(text, label_span, expected_spans)
+    competing_distance = _nearest_span_distance(text, label_span, competing_spans)
+    return expected_distance is not None and (
+        competing_distance is None or expected_distance < competing_distance
+    )
