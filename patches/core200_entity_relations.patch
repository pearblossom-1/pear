+def _matches_semantic_record_table(text: str, contract: Any) -> bool:
+    """Bind item, required/current values, and result by explicit field roles.
+
+    Markdown tables use declared headers; a record may leave a field blank when
+    that field is not part of its contract. Prose, bullets, and key-value notes
+    use item-delimited record segments whose labeled field fragments are evaluated
+    independently. No token-distance heuristic assigns a number to a role.
+    """
+
+    parsed = _parse_semantic_record_table_contract(contract)
+    if parsed is None:
+        return False
+    item_headers, records, field_names, field_labels = parsed
+    table_state = _semantic_record_table_rows_match(
+        text,
+        item_headers,
+        records,
+        field_names,
+        field_labels,
+    )
+    if table_state is not None:
+        return table_state
+
+    normalized = _normalize_preserving_line_breaks(text)
+    anchors: list[tuple[int, int, int]] = []
+    for record_index, record in enumerate(records):
+        anchors.extend(
+            (match.start(), match.end(), record_index)
+            for item in record["items"]
+            for match in _phrase_pattern(item).finditer(normalized)
+        )
+    anchors = sorted(set(anchors))
+    if not anchors:
+        return False
+
+    field_value_domains: dict[str, list[str]] = {name: [] for name in field_names}
+    for record in records:
+        for field in record["fields"]:
+            field_value_domains[field["name"]].extend(field["values"])
+    matched_records: set[int] = set()
+    for index, (start, _end, record_index) in enumerate(anchors):
+        finish = anchors[index + 1][0] if index + 1 < len(anchors) else len(normalized)
+        segment_start = start
+        if len(records) == 1 and len(anchors) == 1:
+            # A natural single-record sentence may put a labeled field before
+            # its item (for example, "Reviewer Mara handles session S-84").
+            # Include only the current sentence/paragraph so preceding history
+            # is not rebound to the scored record.
+            prefix = normalized[:start]
+            boundaries = [
+                match.end()
+                for match in re.finditer(r"(?:[.!?]\s+|\n\s*\n)", prefix)
+            ]
+            segment_start = boundaries[-1] if boundaries else 0
+        state = _semantic_record_text_segment_state(
+            normalized[segment_start:finish],
+            records[record_index],
+            field_value_domains,
+        )
+        if state == "invalid":
+            return False
+        if state == "valid":
+            matched_records.add(record_index)
+    return matched_records == set(range(len(records)))
+
+
+_COORDINATE_PAIR = re.compile(
+    r"(?<![a-z0-9.])"
+    r"([+-]?(?:\d+(?:\.\d+)?|\.\d+))"
+    r"\s*,\s*"
+    r"([+-]?(?:\d+(?:\.\d+)?|\.\d+))"
+    r"(?![a-z0-9]|\.\d)",
+    re.IGNORECASE,
+)
+
+_COORDINATE_HISTORY_MARKER = re.compile(
+    r"\b(?:archived|backup|former|historical|old|previous|prior|stale)\b"
+    r"|\b(?:alternate|alternative)\b|\bnot\s+current\b|\bnon-current\b",
+    re.IGNORECASE,
+)
+
+_COORDINATE_CURRENT_MARKER = re.compile(
+    r"\b(?:active|current|final|now|target)\b",
+    re.IGNORECASE,
+)
+
+_COORDINATE_CLAUSE_BOUNDARY = re.compile(r"[;\n\r!?]|\.(?!\d)")
+
+
+def _coordinate_clause_bounds(text: str, start: int, end: int) -> tuple[int, int]:
+    left = max(
+        (match.end() for match in _COORDINATE_CLAUSE_BOUNDARY.finditer(text, 0, start)),
+        default=0,
+    )
+    right_match = _COORDINATE_CLAUSE_BOUNDARY.search(text, end)
+    return left, right_match.start() if right_match else len(text)
+
+
+def _coordinate_pair_is_historical(text: str, start: int, end: int) -> bool:
+    left, right = _coordinate_clause_bounds(text, start, end)
+    clause = text[left:right]
+    relative_start = start - left
+    markers: list[tuple[int, str]] = []
+    markers.extend(
+        (min(abs(match.start() - relative_start), abs(match.end() - relative_start)), "history")
+        for match in _COORDINATE_HISTORY_MARKER.finditer(clause)
+    )
+    markers.extend(
+        (min(abs(match.start() - relative_start), abs(match.end() - relative_start)), "current")
+        for match in _COORDINATE_CURRENT_MARKER.finditer(clause)
+    )
+    if not markers:
+        return False
+    markers.sort(key=lambda item: (item[0], item[1] != "current"))
+    return markers[0][1] == "history"
+
+
+def _pipe_cell_spans(line: str, offset: int) -> list[tuple[int, int, str]]:
+    separators = [-1, *(index for index, char in enumerate(line) if char == "|"), len(line)]
+    cells: list[tuple[int, int, str]] = []
+    for left, right in zip(separators, separators[1:], strict=False):
+        start = left + 1
+        end = right
+        value = line[start:end]
+        if (left == -1 or right == len(line)) and not value.strip():
+            continue
+        leading = len(value) - len(value.lstrip())
+        trailing = len(value) - len(value.rstrip())
+        cells.append(
+            (
+                offset + start + leading,
+                offset + end - trailing,
+                value.strip(),
+            )
+        )
+    return cells
+
+
+def _coordinate_table_owners(
+    text: str,
+    contracts: list[dict[str, Any]],
+) -> dict[tuple[int, int], int]:
+    """Bind coordinate cells to labeled Markdown table columns."""
+
+    lines = text.splitlines(keepends=True)
+    offsets: list[int] = []
+    position = 0
+    for line in lines:
+        offsets.append(position)
+        position += len(line)
+
+    owners: dict[tuple[int, int], int] = {}
+    for header_index, header in enumerate(lines):
+        if "|" not in header:
+            continue
+        header_cells = _pipe_cell_spans(header, offsets[header_index])
+        columns: dict[int, int] = {}
+        for column, (_start, _end, cell) in enumerate(header_cells):
+            matching_contracts = [
+                index
+                for index, contract in enumerate(contracts)
+                if any(
+                    _phrase_pattern(anchor).search(_normalize(cell))
+                    for anchor in contract["anchor_values"]
+                )
+            ]
+            if len(matching_contracts) == 1:
+                columns[column] = matching_contracts[0]
+        if set(columns.values()) != set(range(len(contracts))):
+            continue
+
+        for row_index in range(header_index + 1, len(lines)):
+            row = lines[row_index]
+            if "|" not in row:
+                break
+            cells = _pipe_cell_spans(row, offsets[row_index])
+            if cells and all(
+                re.fullmatch(r":?-{3,}:?", cell.strip())
+                for _start, _end, cell in cells
+            ):
+                continue
+            if len(cells) != len(header_cells):
+                break
+            for column, owner in columns.items():
+                start, _end, cell = cells[column]
+                for match in _COORDINATE_PAIR.finditer(cell):
+                    owners[(start + match.start(), start + match.end())] = owner
+    return owners
+
+
+def _matches_numeric_coordinate_relations(
+    text: str,
+    contracts: Any,
+    transition_symbols: Any = None,
+) -> bool:
+    """Compare labeled latitude/longitude pairs numerically by named anchor."""
+
+    if not isinstance(contracts, list) or not contracts:
+        return False
