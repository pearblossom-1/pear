+        latitude = contract.get("latitude")
+        longitude = contract.get("longitude")
+        tolerance = contract.get("tolerance", 0.000005)
+        max_gap = contract.get("max_anchor_gap_chars", 240)
+        include_historical = contract.get("include_historical", False)
+        if (
+            (not anchors and not parsed_transition_symbols)
+            or isinstance(latitude, bool)
