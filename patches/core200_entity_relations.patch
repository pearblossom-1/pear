+def _parse_semantic_record_table_contract(
+    contract: Any,
+) -> tuple[list[str], list[dict[str, Any]], list[str], dict[str, list[str]]] | None:
+    if (
+        not isinstance(contract, dict)
+        or set(contract) - {"item_headers", "records"}
+    ):
+        return None
+    item_headers = contract.get("item_headers", ["item"])
+    records = contract.get("records")
+    if (
+        not isinstance(item_headers, list)
+        or not item_headers
+        or any(not isinstance(item, str) or not item.strip() for item in item_headers)
+        or not isinstance(records, list)
+        or not records
+    ):
+        return None
+
+    parsed_records: list[dict[str, Any]] = []
+    field_names: list[str] = []
+    field_labels: dict[str, list[str]] = {}
+    observed_items: set[str] = set()
+    for record in records:
+        if not isinstance(record, dict) or set(record) != {"item", "fields"}:
+            return None
+        items = _alternatives(record.get("item"))
+        raw_fields = record.get("fields")
+        normalized_items = {_semantic_record_normalize(item) for item in items}
+        if (
+            not items
+            or not normalized_items
+            or observed_items.intersection(normalized_items)
+            or not isinstance(raw_fields, list)
+            or not raw_fields
+        ):
+            return None
+        observed_items.update(normalized_items)
+
+        parsed_fields: list[dict[str, Any]] = []
+        names: list[str] = []
+        for field in raw_fields:
+            if (
+                not isinstance(field, dict)
+                or set(field) - {"name", "labels", "values", "allow_unlabeled"}
+            ):
+                return None
+            name = str(field.get("name", "")).strip()
+            labels = _alternatives(field.get("labels"))
+            values = _alternatives(field.get("values"))
+            allow_unlabeled = field.get("allow_unlabeled", False)
+            if (
+                not name
+                or name in names
+                or not labels
+                or not values
+                or not isinstance(allow_unlabeled, bool)
+            ):
+                return None
+            names.append(name)
+            normalized_labels = [_semantic_record_normalize(item) for item in labels]
+            if name in field_labels and set(field_labels[name]) != set(normalized_labels):
+                return None
+            if name not in field_names:
+                field_names.append(name)
+            field_labels[name] = normalized_labels
+            parsed_fields.append(
+                {
+                    "name": name,
+                    "labels": labels,
+                    "values": values,
+                    "allow_unlabeled": allow_unlabeled,
+                }
+            )
+        parsed_records.append(
+            {"item": record["item"], "items": items, "fields": parsed_fields}
+        )
+
+    if not field_names:
+        return None
+    normalized_item_headers = [_semantic_record_normalize(item) for item in item_headers]
+    header_domains = [set(normalized_item_headers), *(
+        set(field_labels[name]) for name in field_names
+    )]
+    if any(
+        left.intersection(right)
+        for index, left in enumerate(header_domains)
+        for right in header_domains[index + 1 :]
+    ):
+        return None
+    return item_headers, parsed_records, field_names, field_labels
+
+
+def _semantic_record_table_rows_match(
+    text: str,
+    item_headers: list[str],
+    records: list[dict[str, Any]],
+    field_names: list[str],
+    field_labels: dict[str, list[str]],
+) -> bool | None:
+    lines = text.replace("\r\n", "\n").replace("\r", "\n").split("\n")
+    recognized = False
+    observed: Counter[str] = Counter()
+    for header_index, raw_line in enumerate(lines):
+        if "|" not in raw_line:
+            continue
+        header_cells = [
+            cell.strip()
+            for cell in raw_line.strip().strip("|").split("|")
+        ]
+        expected_columns = ["item", *field_names]
+        if len(header_cells) != len(expected_columns):
+            continue
+        column_kinds: list[str] = []
+        valid_header = True
+        for cell in header_cells:
+            normalized = _semantic_record_normalize(cell)
+            matches = []
+            if normalized in {
+                _semantic_record_normalize(item) for item in item_headers
+            }:
+                matches.append("item")
+            matches.extend(
+                name for name in field_names if normalized in set(field_labels[name])
+            )
+            if len(matches) != 1:
+                valid_header = False
+                break
+            column_kinds.append(matches[0])
+        if not valid_header or Counter(column_kinds) != Counter(expected_columns):
+            continue
+        recognized = True
+
+        for raw_row in lines[header_index + 1 :]:
+            if "|" not in raw_row:
+                break
+            cells = [cell.strip() for cell in raw_row.strip().strip("|").split("|")]
+            if cells and all(re.fullmatch(r":?-{3,}:?", cell) for cell in cells):
+                continue
+            if len(cells) != len(expected_columns) or not any(cells):
+                return False
+            values = dict(zip(column_kinds, cells, strict=True))
+            matching_records = [
+                record
+                for record in records
+                if _semantic_record_exact(values["item"], record["item"])
+            ]
+            if len(matching_records) != 1:
+                return False
+            record = matching_records[0]
+            if any(
+                not _semantic_record_exact(values[field["name"]], field["values"])
+                for field in record["fields"]
+            ):
+                return False
+            record_field_names = {field["name"] for field in record["fields"]}
+            if any(
+                str(values[name]).strip()
+                for name in field_names
+                if name not in record_field_names
+            ):
+                return False
+            observed[_semantic_record_normalize(record["items"][0])] += 1
+
+    if not recognized:
+        return None
+    return all(observed[_semantic_record_normalize(record["items"][0])] >= 1 for record in records)
+
+
+def _semantic_record_text_segment_state(
+    segment: str,
+    record: dict[str, Any],
+    field_value_domains: dict[str, list[str]],
+) -> str:
+    fragments = [
+        _semantic_record_normalize(fragment)
+        for fragment in re.split(
+            r"[,;|\n\r]+|(?<=[.!?])\s+|\b(?:and|while)\b",
+            segment,
+            flags=re.IGNORECASE,
+        )
+        if _semantic_record_normalize(fragment)
+    ]
+    field_matches: dict[str, bool] = {}
+    has_signal = False
+    for field in record["fields"]:
+        name = field["name"]
+        labeled = [
+            fragment
+            for fragment in fragments
+            if _semantic_record_contains(fragment, field["labels"])
+        ]
+        expected_labeled = [
+            fragment
+            for fragment in labeled
+            if _semantic_record_contains(fragment, field["values"])
+        ]
+        if labeled:
+            has_signal = True
+        for fragment in labeled:
+            declared_values = _semantic_record_declared_values(
+                fragment,
+                field_value_domains[name],
+            )
+            expected_here = _semantic_record_contains(fragment, field["values"])
+            numeric_claim = bool(re.search(r"(?<![a-z0-9])[+-]?\d+(?:\.\d+)?(?![a-z0-9])", fragment))
+            expected_is_numeric = any(
+                re.search(r"\d", value) for value in _alternatives(field["values"])
+            )
+            if (
+                any(
+                    not _semantic_record_exact(value, field["values"])
+                    for value in declared_values
+                )
+                or expected_is_numeric and numeric_claim and not expected_here
+            ):
+                return "invalid"
+        matched = bool(expected_labeled)
+        if field["allow_unlabeled"]:
+            declared_in_segment = _semantic_record_declared_values(
+                segment,
+                field_value_domains[name],
+            )
+            if declared_in_segment:
+                has_signal = True
+            if any(
+                not _semantic_record_exact(value, field["values"])
+                for value in declared_in_segment
+            ):
+                return "invalid"
+            matched = matched or _semantic_record_contains(segment, field["values"])
+        field_matches[name] = matched
+    if not has_signal:
+        return "ignore"
+    return "valid" if all(field_matches.values()) else "invalid"
+
