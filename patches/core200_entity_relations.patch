+def _semantic_record_normalize(value: Any) -> str:
+    """Normalize presentation-only differences in one structured record cell."""
+
+    text = _normalize(canonicalize_status_phrases(value)).replace("_", " ")
+    text = re.sub(r"(?<=[a-z])(?=[+-]?\d)", " ", text, flags=re.IGNORECASE)
+    text = re.sub(r"(?<=\d)(?=[a-z])", " ", text, flags=re.IGNORECASE)
+    return re.sub(r"\s+", " ", text).strip(" \t:=-")
+
+
+def _semantic_record_exact(value: Any, alternatives: Any) -> bool:
+    normalized = _semantic_record_normalize(value)
+    return any(
+        normalized == _semantic_record_normalize(alternative)
+        for alternative in _alternatives(alternatives)
+    )
+
+
+def _semantic_record_contains(value: Any, alternatives: Any) -> bool:
+    normalized = _semantic_record_normalize(value)
+    return any(
+        _phrase_pattern(_semantic_record_normalize(alternative)).search(normalized)
+        for alternative in _alternatives(alternatives)
+    )
+
+
+def _semantic_record_declared_values(value: Any, alternatives: Any) -> list[str]:
+    """Return asserted values, preferring a longer phrase over its substring."""
+
+    normalized = _semantic_record_normalize(value)
+    matches: list[tuple[int, int, str]] = []
+    for alternative in _alternatives(alternatives):
+        phrase = _semantic_record_normalize(alternative)
+        matches.extend(
+            (match.start(), match.end(), alternative)
+            for match in _phrase_pattern(phrase).finditer(normalized)
+        )
+    maximal = [
+        match
+        for match in matches
+        if not any(
+            other[0] <= match[0]
+            and match[1] <= other[1]
+            and (other[0], other[1]) != (match[0], match[1])
+            for other in matches
+        )
+    ]
+    return list(dict.fromkeys(match[2] for match in maximal))
+
