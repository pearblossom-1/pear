{
  "id": "android_smarthome_265",
  "instruction": "Open the `Dry Air Rule` note in Markor on the phone and check the live bedroom humidity in Home. Follow the rule, then use the `Home Updates` contact to send a concise message with the current humidity, the rule's threshold, how the reading compares with it, and the humidifier setting that was applied.",
  "devices": [
    {
      "id": "android_0",
      "type": "android"
    },
    {
      "id": "home_0",
      "type": "home"
    }
  ],
  "setup": [
    {
      "device_id": "android_0",
      "config": [
        {
          "type": "ensure_app",
          "parameters": {
            "app": "markor"
          }
        },
        {
          "type": "upload_file",
          "parameters": {
            "files": [
              {
                "local_path": "${repo_root}/tasks/cross_device/android_smarthome_assets/android_smarthome_265/android/android_0/markor/Dry Air Rule.md",
                "path": "/storage/emulated/0/Documents/Markor/Dry Air Rule.md"
              }
            ]
          }
        },
        {
          "type": "androidworld_markor_note_preflight",
          "parameters": {
            "path": "/storage/emulated/0/Documents/Markor/Dry Air Rule.md",
            "required_visible_text": [
              "bedroom humidity",
              "below 35%",
              "humidifier high"
            ]
          }
        },
        {
          "type": "ensure_app",
          "parameters": {
            "app": "contacts"
          }
        },
        {
          "type": "androidworld_contacts_clear",
          "parameters": {}
        },
        {
          "type": "androidworld_contact_add",
          "parameters": {
            "name": "Home Updates",
            "number": "5559431",
            "notes": "Receives bedroom humidity notices."
          }
        },
        {
          "type": "androidworld_contact_preflight",
          "parameters": {
            "contact": {
              "name": "Home Updates",
              "number": "5559431",
              "notes_exact": "Receives bedroom humidity notices."
            },
            "required_visible_text": [
              "Home Updates",
              "5559431",
              "bedroom humidity notices"
            ]
          }
        },
        {
          "type": "ensure_app",
          "parameters": {
            "app": "simple sms messenger"
          }
        },
        {
          "type": "androidworld_sms_clear",
          "parameters": {}
        }
      ]
    },
    {
      "device_id": "home_0",
      "config": [
        {
          "type": "smarthome.reset",
          "parameters": {
            "episode_config_ref": "tasks/cross_device/android_smarthome_assets/android_smarthome_265/episode_config.json"
          }
        }
      ]
    }
  ],
  "cleanup": [
    {
      "device_id": "android_0",
      "config": [
        {
          "type": "adb_shell",
          "parameters": {
            "command": "rm -f '/storage/emulated/0/Documents/Markor/Dry Air Rule.md'"
          }
        },
        {
          "type": "androidworld_contacts_clear",
          "parameters": {}
        },
        {
          "type": "androidworld_sms_clear",
          "parameters": {}
        }
      ]
    },
    {
      "device_id": "home_0",
      "config": [
        {
          "type": "smarthome.reset",
          "parameters": {}
        }
      ]
    }
  ],
  "evaluation": [
    {
      "device_id": "android_0",
      "func": "exact_match",
      "result": {
        "type": "androidworld_sms_message",
        "box": "sent",
        "address": "5559431",
        "recent_within_mins": 30,
        "body_relation": {
          "entities": [
            [
              "bedroom"
            ],
            [
              "humidity"
            ],
            [
              "32",
              "32%"
            ],
            [
              "35",
              "35%"
            ],
            [
              "humidifier"
            ],
            [
              "high"
            ]
          ],
          "relation_groups": [
            {
              "entities": [
                "humidifier",
                "high"
              ],
              "allow_multiple_matches": true
            }
          ],
          "conflict_patterns": [
            "\\b32(?:\\.0)?%?\\b[^\\r\\n.!?]{0,48}\\b(?:above|over|higher\\s+than)\\b[^\\r\\n.!?]{0,24}\\b35(?:\\.0)?%?\\b"
          ],
          "required_phrases": [
            [
              "below",
              "under",
              "lower than"
            ]
          ],
          "required_patterns": [
            "\\b32(?:\\.0)?%?\\b[^\\r\\n.!?]{0,48}\\b(?:below|under|lower\\s+than)\\b[^\\r\\n.!?]{0,24}\\b35(?:\\.0)?%?\\b"
          ]
        }
      },
      "expected": {
        "type": "rule",
        "rules": {
          "expected": "present"
        }
      },
      "name": "Home Updates receives the bound bedroom 32-below-35 high-humidifier result"
    },
    {
      "device_id": "home_0",
      "func": "smarthome.check_device_state",
      "result": {
        "type": "smarthome_device_state",
        "device_id": "bedroom_humidifier_1"
      },
      "expected": {
        "type": "rule",
        "rules": {
          "expected": {
            "power": "on",
            "level": "high"
          }
        }
      },
      "name": "bedroom humidifier is on at high"
    },
    {
      "device_id": "home_0",
      "func": "smarthome.check_allowed_state_diff",
      "result": {
        "type": "smarthome_home_state"
      },
      "expected": {
        "type": "rule",
        "rules": {
          "expected": {
            "allowed_device_field_changes": {
              "bedroom_humidifier_1": {
                "power": "on",
                "level": "high"
              }
            },
            "preserve_schedules": true,
            "preserve_workflows": true
          }
        }
      },
      "name": "only the bedroom humidifier final state changes"
    }
  ],
  "limits": {
    "max_steps": 50
  },
