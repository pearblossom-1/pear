{
  "id": "android_smarthome_409",
  "instruction": "Open `comfort_requests.csv` in Downloads/home on the phone and complete the `Comfort request results` note in Markor. Process both living-room requests against the live Home capabilities: carry out any request Home supports, and for any request it cannot support, record that result and the reason in the corresponding section of the note.",
  "devices": [
    {
      "id": "android_0",
      "type": "android"
    },
    {
      "id": "home_0",
      "type": "home"
    }
  ],
  "setup": [
    {
      "device_id": "android_0",
      "config": [
        {
          "type": "ensure_app",
          "parameters": {
            "app": "files"
          }
        },
        {
          "type": "ensure_app",
          "parameters": {
            "app": "markor"
          }
        },
        {
          "type": "adb_shell",
          "parameters": {
            "command": "rm -f '/storage/emulated/0/Documents/Markor/Comfort request results.md'"
          }
        },
        {
          "type": "upload_file",
          "parameters": {
            "files": [
              {
                "local_path": "${repo_root}/tasks/cross_device/android_smarthome_assets/android_smarthome_409/android/android_0/files/comfort_requests.csv",
                "path": "/storage/emulated/0/Download/home/comfort_requests.csv"
              },
              {
                "local_path": "${repo_root}/tasks/cross_device/android_smarthome_assets/android_smarthome_409/android/android_0/files/comfort_results_format.md",
                "path": "/storage/emulated/0/Documents/Markor/Comfort request results.md"
              }
            ]
          }
        }
      ]
    },
    {
      "device_id": "home_0",
      "config": [
        {
          "type": "smarthome.reset",
          "parameters": {
            "episode_config_ref": "tasks/cross_device/android_smarthome_assets/android_smarthome_409/episode_config.json"
          }
        }
      ]
    }
  ],
  "cleanup": [
    {
      "device_id": "android_0",
      "config": [
        {
          "type": "adb_shell",
          "parameters": {
            "command": "rm -f /storage/emulated/0/Download/home/comfort_requests.csv"
          }
