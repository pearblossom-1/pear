{
  "id": "android_smarthome_251",
  "instruction": "Read the bedroom setup request in Simple SMS Messenger on the phone and the matching `Bedroom Updates` contact note in Contacts. Make the requested Home changes, then reply in Simple SMS Messenger using the confirmation style from the contact note.",
  "devices": [
    {
      "id": "android_0",
      "type": "android"
    },
    {
      "id": "home_0",
      "type": "home"
    }
  ],
  "setup": [
    {
      "device_id": "android_0",
      "config": [
        {
          "type": "ensure_app",
          "parameters": {
            "app": "simple sms messenger"
          }
        },
        {
          "type": "androidworld_sms_clear",
          "parameters": {}
        },
        {
          "type": "androidworld_sms_receive",
          "parameters": {
            "address": "5556284",
            "body": "Set bedroom light to 20% and curtain closed, then reply.",
            "wait_s": 5.0
          }
        },
        {
          "type": "androidworld_sms_message_preflight",
          "parameters": {
            "message": {
              "box": "inbox",
              "address": "5556284",
              "body": "Set bedroom light to 20% and curtain closed, then reply.",
              "require_exactly_one_for_address": true
            },
            "required_visible_text": [
              "bedroom light to 20%",
              "curtain closed",
              "then reply"
            ]
          }
        },
        {
          "type": "ensure_app",
          "parameters": {
            "app": "contacts"
          }
        },
        {
          "type": "androidworld_contacts_clear",
          "parameters": {}
        },
        {
          "type": "androidworld_contact_add",
          "parameters": {
            "name": "Bedroom Updates",
            "number": "5556284",
            "notes": "Receives bedroom setup replies in this style: Bedroom light is at LEVEL%; curtain is closed."
          }
        },
        {
          "type": "androidworld_contact_preflight",
          "parameters": {
            "contact": {
              "name": "Bedroom Updates",
              "number": "5556284",
              "notes_exact": "Receives bedroom setup replies in this style: Bedroom light is at LEVEL%; curtain is closed."
            },
            "required_visible_text": [
              "Bedroom Updates",
              "5556284",
              "Bedroom light is at LEVEL%",
              "curtain is closed"
            ]
          }
        }
      ]
    },
    {
      "device_id": "home_0",
      "config": [
        {
          "type": "smarthome.reset",
          "parameters": {
            "episode_config_ref": "tasks/cross_device/android_smarthome_assets/android_smarthome_251/episode_config.json"
          }
        }
      ]
    }
  ],
  "cleanup": [
    {
      "device_id": "android_0",
      "config": [
        {
          "type": "androidworld_sms_clear",
          "parameters": {}
        },
        {
          "type": "androidworld_contacts_clear",
          "parameters": {}
        }
      ]
    },
    {
      "device_id": "home_0",
      "config": [
        {
          "type": "smarthome.reset",
          "parameters": {}
        }
      ]
    }
  ],
  "evaluation": [
    {
      "device_id": "android_0",
      "func": "exact_match",
      "result": {
        "type": "androidworld_sms_message",
        "box": "sent",
        "address": "5556284",
        "recent_within_mins": 30,
        "body_relation": {
          "entities": [
            [
              "bedroom"
            ],
            [
              "light"
            ],
            [
              "20",
              "20%"
            ],
            [
              "curtain"
            ],
            [
              "closed",
              "close"
            ]
          ],
          "ordered_entities": [
            [
              "light"
            ],
            [
              "20",
              "20%"
            ],
            [
              "curtain"
            ],
            [
              "closed",
              "close"
            ]
          ],
          "relation_groups": [
            {
              "entities": [
                "light",
                [
                  "20",
                  "20%"
                ]
              ],
              "allow_multiple_matches": true
            },
            {
              "entities": [
                "curtain",
                [
                  "closed",
                  "close"
                ]
              ],
              "allow_multiple_matches": true
            }
          ],
          "conflict_phrases": [
            "not closed"
          ]
        }
      },
      "expected": {
        "type": "rule",
        "rules": {
          "expected": "present"
        }
      },
      "name": "Bedroom Updates receives the completed light-and-curtain reply"
    },
    {
      "device_id": "home_0",
      "func": "smarthome.check_device_state",
      "result": {
        "type": "smarthome_device_state",
        "device_id": "bedroom_dimmable_light_1"
      },
      "expected": {
        "type": "rule",
        "rules": {
          "expected": {
            "power": "on",
            "brightness_pct": 20
          }
        }
      },
      "name": "bedroom light is on at 20 percent"
    },
    {
      "device_id": "home_0",
      "func": "smarthome.check_device_state",
      "result": {
        "type": "smarthome_device_state",
        "device_id": "bedroom_curtain_1"
      },
      "expected": {
        "type": "rule",
        "rules": {
          "expected": {
            "open_pct": 0
          }
        }
      },
      "name": "bedroom curtain is closed"
    },
    {
      "device_id": "home_0",
      "func": "smarthome.check_allowed_state_diff",
      "result": {
        "type": "smarthome_home_state"
      },
      "expected": {
        "type": "rule",
        "rules": {
          "expected": {
            "allowed_device_field_changes": {
              "bedroom_dimmable_light_1": {
                "brightness_pct": 20
              },
              "bedroom_curtain_1": {
                "open_pct": 0,
                "status": "closed"
              }
            },
            "preserve_schedules": true,
            "preserve_workflows": true
          }
        }
      },
      "name": "only the requested bedroom light and curtain fields change"
    }
  ],
  "limits": {
    "max_steps": 50
  },
