{
  "id": "android_smarthome_251",
  "instruction": "On this phone, a request in Simple SMS Messenger and the matching note in Android Contacts specify a bedroom setup, its reply destination, and the requested confirmation style. Make the Home changes, then reply in Simple SMS Messenger using that style with the completed light and curtain settings.",
  "devices": [
    {
      "id": "android_0",
      "type": "android"
    },
    {
      "id": "home_0",
      "type": "home"
    }
  ],
  "setup": [
