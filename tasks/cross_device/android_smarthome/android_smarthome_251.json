            "app": "contacts"
          }
        },
        {
          "type": "androidworld_contacts_clear",
          "parameters": {}
        },
        {
          "type": "androidworld_contact_add",
          "parameters": {
            "name": "Bedroom Updates",
            "number": "5552510",
            "notes": "Receives bedroom setup replies in this style: Bedroom light is at LEVEL%; curtain is closed."
          }
        },
        {
          "type": "androidworld_contact_preflight",
          "parameters": {
            "contact": {
              "name": "Bedroom Updates",
              "number": "5552510",
              "notes_exact": "Receives bedroom setup replies in this style: Bedroom light is at LEVEL%; curtain is closed."
            },
            "required_visible_text": [
              "Bedroom Updates",
              "5552510",
              "Bedroom light is at LEVEL%",
              "curtain is closed"
            ]
          }
        }
      ]
    },
    {
      "device_id": "home_0",
      "config": [
        {
          "type": "smarthome.reset",
          "parameters": {
            "episode_config_ref": "tasks/cross_device/android_smarthome_assets/android_smarthome_251/episode_config.json"
