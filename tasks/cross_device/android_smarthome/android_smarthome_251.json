            "body": "Set bedroom light to 20% and curtain closed, then reply.",
            "wait_s": 5.0
          }
        },
        {
          "type": "androidworld_sms_message_preflight",
          "parameters": {
            "message": {
              "box": "inbox",
              "address": "5552510",
              "body": "Set bedroom light to 20% and curtain closed, then reply.",
              "require_exactly_one_for_address": true
            },
            "required_visible_text": [
              "bedroom light to 20%",
              "curtain closed",
              "then reply"
            ]
          }
        },
        {
          "type": "ensure_app",
