{
  "id": "android_smarthome_407",
  "instruction": "Simple Gallery Pro has an entry inspection photo, and the Files app's `gallery_manifest.csv` lists the checks to complete. Inspect the photo, query the corresponding live Home state, and create a Markor note named `Entry inspection audit`. In the note, identify the manifest photo and room, then record the requested door and shoe observations together with the live brightness reading and light state. Do not control any devices.",
  "devices": [
    {
      "id": "android_0",
      "type": "android"
    },
    {
      "id": "home_0",
      "type": "home"
    }
  ],
  "setup": [
    {
      "device_id": "android_0",
      "config": [
        {
          "type": "ensure_app",
          "parameters": {
            "app": "simple gallery pro"
          }
        },
        {
          "type": "adb_shell",
          "parameters": {
            "command": "rm -f '/sdcard/DCIM/Camera/entry_photo_407.png'; content delete --uri content://media/external/images/media --where \"_data='/sdcard/DCIM/Camera/entry_photo_407.png'\" >/dev/null 2>&1 || true; content delete --uri content://media/external/images/media --where \"_data='/storage/emulated/0/DCIM/Camera/entry_photo_407.png'\" >/dev/null 2>&1 || true; mkdir -p '/sdcard/DCIM/Camera'"
          }
        },
        {
          "type": "upload_file",
          "parameters": {
            "files": [
              {
                "local_path": "${repo_root}/tasks/cross_device/android_smarthome_assets/android_smarthome_407/android/android_0/gallery/entry_photo_407.png",
                "path": "/sdcard/DCIM/Camera/entry_photo_407.png"
              }
            ]
          }
        },
        {
          "type": "adb_shell",
          "parameters": {
            "command": "am broadcast -a android.intent.action.MEDIA_SCANNER_SCAN_FILE -d file://'/sdcard/DCIM/Camera/entry_photo_407.png' >/dev/null 2>&1 || true"
          }
        },
        {
          "type": "androidworld_gallery_media_details_preflight",
          "parameters": {
            "path": "/sdcard/DCIM/Camera/entry_photo_407.png",
            "filename": "entry_photo_407.png",
            "relative_path": "DCIM/Camera/",
            "mime_type": "image/png"
          }
        },
        {
          "type": "ensure_app",
          "parameters": {
            "app": "files"
          }
        },
        {
          "type": "ensure_app",
          "parameters": {
            "app": "markor"
          }
        },
        {
          "type": "adb_shell",
          "parameters": {
            "command": "rm -f '/storage/emulated/0/Documents/Markor/Entry inspection audit.md'"
          }
        },
        {
          "type": "upload_file",
          "parameters": {
            "files": [
              {
                "local_path": "${repo_root}/tasks/cross_device/android_smarthome_assets/android_smarthome_407/android/android_0/files/gallery_manifest.csv",
                "path": "/storage/emulated/0/Download/gallery_manifest.csv"
              }
            ]
          }
        },
        {
          "type": "androidworld_files_directory_preflight",
          "parameters": {
            "directory": "/storage/emulated/0/Download",
            "expected_filenames": [
              "gallery_manifest.csv"
            ],
            "open_filename": "gallery_manifest.csv",
            "required_visible_text": [
              "entry_photo_407.png",
              "inspect whether the entry door is open or closed"
            ]
          }
        }
      ]
    },
    {
      "device_id": "home_0",
      "config": [
        {
          "type": "smarthome.reset",
          "parameters": {
            "episode_config_ref": "tasks/cross_device/android_smarthome_assets/android_smarthome_407/episode_config.json"
          }
