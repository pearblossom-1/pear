              "inspect whether the entry door is open or closed"
            ]
          }
        }
      ]
    },
    {
      "device_id": "home_0",
      "config": [
        {
          "type": "smarthome.reset",
          "parameters": {
            "episode_config_ref": "tasks/cross_device/android_smarthome_assets/android_smarthome_407/episode_config.json"
