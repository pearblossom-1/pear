      "func": "exact_match",
      "result": {
        "type": "android_entity_relation_note",
        "path": "/storage/emulated/0/Documents/Markor/Entry inspection audit.md",
        "rules": {
          "entities": [
            "entry_photo_407.png",
            "entry",
            "door",
            "shoes",
            "brightness",
            [
              "82 lux",
              "82.0 lux"
            ],
            "light"
          ],
          "conflict_phrases": [
            "door open",
            "no shoes",
            "shoes absent",
            "light on"
          ],
          "conflict_patterns": [
            "\\b(?:entry\\s+)?door\\b\\s*(?:status\\s*[:=]\\s*)?(?:is\\s+)?open\\b",
            "\\b(?:no\\s+shoes|shoes\\b\\s*(?:status\\s*[:=]\\s*)?(?:(?:are\\s+)?(?:absent|missing)|(?:are\\s+)?not\\s+present))\\b",
            "\\blight\\b\\s*(?:state\\s*[:=]\\s*)?(?:is\\s+)?on\\b"
          ],
          "relation_groups": [
