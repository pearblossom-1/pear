{
  "id": "android_smarthome_407",
  "instruction": "Open the entry inspection photo in Simple Gallery Pro on the phone and `gallery_manifest.csv` in Downloads/home. Use the manifest to inspect the requested visual details, check the corresponding live Home state, and create a Markor note called `Entry inspection audit` with the photo, room, requested door and shoe observations, brightness reading, and light state. Do not control any Home devices.",
  "devices": [
    {
      "id": "android_0",
      "type": "android"
    },
    {
      "id": "home_0",
      "type": "home"
    }
  ],
  "setup": [
