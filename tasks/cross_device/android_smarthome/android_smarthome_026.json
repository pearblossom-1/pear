{
  "id": "android_smarthome_026",
  "instruction": "Open the `Sleep` event in Simple Calendar Pro on the phone and follow the sleep rule in its description using the live bedroom conditions. If the rule triggers, schedule the required bedtime preparation and create a Markor note called `Sleep Decision` with the bedroom, planned time, temperature, and light setting.",
  "devices": [
    {
      "id": "android_0",
      "type": "android"
    },
    {
      "id": "home_0",
      "type": "home"
    }
  ],
  "setup": [
    {
      "device_id": "android_0",
      "config": [
        {
          "type": "ensure_app",
          "parameters": {
            "app": "simple calendar pro"
          }
        },
        {
          "type": "androidworld_calendar_clear",
          "parameters": {}
        },
        {
          "type": "androidworld_calendar_event_add",
          "parameters": {
            "title": "Sleep",
            "start_ts": 1781641200,
            "end_ts": 1781676000,
            "location": "Home",
            "description": "Sleep starts at 20:20. If the bedroom is above 24 C or brighter than 100 lux, create the fix workflow 40 minutes before sleep: cool to 22 C and dim the bedroom light to 15%."
          }
        },
        {
          "type": "androidworld_calendar_event_preflight",
          "parameters": {
            "title": "Sleep",
            "start_ts": 1781641200,
            "location": "Home",
            "description": "Sleep starts at 20:20. If the bedroom is above 24 C or brighter than 100 lux, create the fix workflow 40 minutes before sleep: cool to 22 C and dim the bedroom light to 15%.",
            "search_text": "Sleep"
          }
        },
        {
          "type": "ensure_app",
          "parameters": {
            "app": "markor"
          }
        },
        {
          "type": "adb_shell",
          "parameters": {
            "command": "rm -f '/storage/emulated/0/Documents/Markor/Sleep Decision.md'"
          }
        }
      ]
    },
    {
      "device_id": "home_0",
      "config": [
        {
          "type": "smarthome.reset",
          "parameters": {
            "episode_config_ref": "tasks/cross_device/android_smarthome_assets/android_smarthome_026/episode_config.json"
          }
        }
      ]
    }
  ],
  "cleanup": [
    {
      "device_id": "android_0",
      "config": [
        {
          "type": "androidworld_calendar_clear",
          "parameters": {}
        },
        {
          "type": "adb_shell",
          "parameters": {
            "command": "rm -f '/storage/emulated/0/Documents/Markor/Sleep Decision.md'"
          }
        }
      ]
    },
    {
      "device_id": "home_0",
      "config": [
        {
          "type": "smarthome.reset",
          "parameters": {}
        }
      ]
    }
  ],
  "evaluation": [
    {
      "device_id": "android_0",
      "func": "exact_match",
      "result": {
        "type": "android_entity_relation_note",
        "path": "/storage/emulated/0/Documents/Markor/Sleep Decision.md",
        "rules": {
          "entities": [
            "bedroom",
            "19:40",
            [
              "22 C",
              "22C"
            ],
            [
              "15%",
              "15 percent"
            ]
          ]
        }
      },
      "expected": {
        "type": "rule",
        "rules": {
          "expected": "pass"
        }
      },
      "name": "Sleep Decision records the four publicly requested bedtime fields"
    },
    {
      "device_id": "home_0",
      "func": "smarthome.check_planned_effects",
      "result": {
        "type": "smarthome_home_state"
      },
      "expected": {
        "type": "rule",
        "rules": {
          "expected": {
            "exact_active_plan_count": 1,
            "plans": [
              {
                "run_at": "2026-06-16T19:40:00",
                "effects": {
                  "bedroom_air_conditioner_1": {
                    "power": "on",
                    "mode": "cool",
                    "target_temperature_c": 22.0
                  },
                  "bedroom_dimmable_light_1": {
                    "power": "on",
                    "brightness_pct": 15
                  }
                }
              }
            ]
          }
        }
      },
      "name": "the 19:40 bedtime effects may use a workflow or equivalent schedules"
    }
  ],
  "limits": {
    "max_steps": 50
  },
  "metadata": {
    "category": "android_smarthome",
