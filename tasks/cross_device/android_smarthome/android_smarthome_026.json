{
  "id": "android_smarthome_026",
  "instruction": "Simple Calendar Pro has the sleep rule for the scheduled Sleep event. Check the live bedroom conditions, schedule the prescribed bedtime prep if the rule triggers, and write a Markor note titled `Sleep Decision` recording the decision, scheduled time, temperature, and light setting (or why no change was needed).",
  "devices": [
    {
      "id": "android_0",
      "type": "android"
    },
    {
      "id": "home_0",
      "type": "home"
    }
  ],
  "setup": [
    {
      "device_id": "android_0",
      "config": [
        {
          "type": "ensure_app",
          "parameters": {
            "app": "simple calendar pro"
          }
        },
        {
          "type": "androidworld_calendar_clear",
          "parameters": {}
        },
        {
          "type": "androidworld_calendar_event_add",
          "parameters": {
            "title": "Sleep",
            "start_ts": 1781641200,
            "end_ts": 1781676000,
            "location": "Home",
            "description": "Sleep starts at 20:20. If the bedroom is above 24 C or brighter than 100 lux, create the fix workflow 40 minutes before sleep: cool to 22 C and dim the bedroom light to 15%."
          }
        },
        {
          "type": "androidworld_calendar_event_preflight",
          "parameters": {
            "title": "Sleep",
            "start_ts": 1781641200,
            "location": "Home",
            "description": "Sleep starts at 20:20. If the bedroom is above 24 C or brighter than 100 lux, create the fix workflow 40 minutes before sleep: cool to 22 C and dim the bedroom light to 15%.",
            "search_text": "Sleep"
          }
        },
        {
          "type": "ensure_app",
          "parameters": {
            "app": "markor"
          }
        },
        {
          "type": "adb_shell",
          "parameters": {
            "command": "rm -f '/storage/emulated/0/Documents/Markor/Sleep Decision.md'"
          }
        }
      ]
    },
    {
      "device_id": "home_0",
      "config": [
        {
          "type": "smarthome.reset",
          "parameters": {
            "episode_config_ref": "tasks/cross_device/android_smarthome_assets/android_smarthome_026/episode_config.json"
          }
        }
      ]
    }
  ],
  "cleanup": [
    {
      "device_id": "android_0",
      "config": [
        {
          "type": "androidworld_calendar_clear",
          "parameters": {}
        },
        {
          "type": "adb_shell",
          "parameters": {
            "command": "rm -f '/storage/emulated/0/Documents/Markor/Sleep Decision.md'"
          }
        }
      ]
    },
    {
      "device_id": "home_0",
      "config": [
        {
          "type": "smarthome.reset",
          "parameters": {}
        }
      ]
    }
  ],
  "evaluation": [
    {
      "device_id": "android_0",
      "func": "exact_match",
      "result": {
        "type": "android_entity_relation_note",
        "path": "/storage/emulated/0/Documents/Markor/Sleep Decision.md",
        "rules": {
          "entities": [
            "bedroom",
            "19:40",
            [
              "22 C",
              "22C"
            ],
            [
              "15%",
              "15 percent"
            ]
          ],
          "conflict_phrases": [
            "not scheduled",
            "no change needed",
            "cancelled",
            "pending",
            "applied now",
            "already applied",
            "were applied now"
          ],
          "relation_groups": [
            {
              "entities": [
                [
                  "bedtime prep",
                  "sleep prep",
                  "preparation",
                  "workflow"
                ],
                [
                  "scheduled",
                  "planned",
                  "arranged"
                ]
              ],
              "allow_multiple_matches": true
            }
          ]
        }
      },
      "expected": {
        "type": "rule",
        "rules": {
          "expected": "pass"
        }
      },
      "name": "sleep note states the 19:40 fix as a scheduled future workflow"
    },
    {
      "device_id": "android_0",
      "func": "exact_match",
      "result": {
        "type": "android_entity_relation_note",
