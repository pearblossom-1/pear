      "parameters": {
        "device_id": "bedroom_humidifier_1",
        "command": "turn_on",
        "args": {}
      }
    },
    {
      "device_id": "home_0",
      "type": "smarthome.command",
      "parameters": {
        "device_id": "bedroom_humidifier_1",
        "command": "set_level",
        "args": {
          "level": "high"
        }
      }
    },
    {
      "type": "done"
    }
  ]
}
