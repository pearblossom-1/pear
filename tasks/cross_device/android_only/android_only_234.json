{
  "id": "android_only_234",
  "instruction": "Open the `photo_manifest` note in Markor on the first phone. On the second phone, use Files to check the `Pictures/Site` folder and see which listed photos are present. Then create a Markor note on the second phone and save it as `photo_status.md`, reporting each listed photo as present or missing. Do not take or create replacement photos.",
  "devices": [
    {
      "id": "android_0",
      "type": "android"
    },
    {
      "id": "android_1",
      "type": "android"
    }
  ],
  "variables": {},
  "setup": [
    {
      "device_id": "android_0",
      "config": [
        {
          "type": "ensure_app",
          "parameters": {
            "app": "markor"
          }
        },
        {
          "type": "upload_file",
          "parameters": {
            "files": [
              {
                "local_path": "${repo_root}/tasks/cross_device/android_only_assets/android_only_234/android_0/markor/photo_manifest.md",
                "path": "/storage/emulated/0/Documents/Markor/photo_manifest.md"
              }
            ]
          }
        },
        {
          "type": "androidworld_markor_note_preflight",
          "parameters": {
            "path": "/storage/emulated/0/Documents/Markor/photo_manifest.md",
            "required_visible_text": [
              "north_gate.png",
              "meter_panel.png",
              "old_notice.png"
            ]
          }
        }
      ]
    },
    {
      "device_id": "android_1",
      "config": [
        {
          "type": "ensure_app",
          "parameters": {
            "app": "files"
          }
        },
        {
          "type": "adb_shell",
          "parameters": {
            "command": "mkdir -p /sdcard/Pictures/Site && rm -f /sdcard/Pictures/Site/north_gate.png /sdcard/Pictures/Site/meter_panel.png /sdcard/Pictures/Site/old_notice.png && content delete --uri content://media/external/images/media --where \"_display_name='north_gate.png'\" >/dev/null 2>&1 || true && content delete --uri content://media/external/images/media --where \"_display_name='meter_panel.png'\" >/dev/null 2>&1 || true && content delete --uri content://media/external/images/media --where \"_display_name='old_notice.png'\" >/dev/null 2>&1 || true"
          }
        },
        {
          "type": "upload_file",
          "parameters": {
            "files": [
              {
                "local_path": "${repo_root}/tasks/cross_device/android_only_assets/android_only_234/android_1/site_photos/north_gate.png",
                "path": "/sdcard/Pictures/Site/north_gate.png"
              },
              {
                "local_path": "${repo_root}/tasks/cross_device/android_only_assets/android_only_234/android_1/site_photos/meter_panel.png",
                "path": "/sdcard/Pictures/Site/meter_panel.png"
              }
            ]
          }
        },
        {
          "type": "adb_shell",
          "parameters": {
            "command": "am broadcast -a android.intent.action.MEDIA_SCANNER_SCAN_FILE -d file:///sdcard/Pictures/Site/north_gate.png >/dev/null 2>&1 || true && am broadcast -a android.intent.action.MEDIA_SCANNER_SCAN_FILE -d file:///sdcard/Pictures/Site/meter_panel.png >/dev/null 2>&1 || true"
          }
        },
        {
          "type": "androidworld_files_directory_preflight",
          "parameters": {
            "directory": "/sdcard/Pictures/Site",
            "expected_filenames": [
              "north_gate.png",
              "meter_panel.png"
            ],
            "missing_filenames": [
              "old_notice.png"
            ]
          }
        },
        {
          "type": "androidworld_filesystem_snapshot",
          "parameters": {
            "snapshot_id": "android_only_234_site",
            "directories": [],
            "files": [
              "/sdcard/Pictures/Site/north_gate.png",
              "/sdcard/Pictures/Site/meter_panel.png",
              "/sdcard/Pictures/Site/old_notice.png"
            ]
          }
        },
        {
          "type": "ensure_app",
          "parameters": {
            "app": "markor"
          }
        },
        {
          "type": "adb_shell",
          "parameters": {
            "command": "rm -f /storage/emulated/0/Documents/Markor/photo_status.md /storage/emulated/0/Documents/Markor/Markor/photo_status.md"
          }
        },
        {
          "type": "androidworld_markor_root_preflight",
          "parameters": {
            "path": "/storage/emulated/0/Documents/Markor"
          }
        }
      ]
    }
  ],
  "cleanup": [
    {
      "device_id": "android_0",
      "config": [
        {
          "type": "adb_shell",
          "parameters": {
            "command": "rm -f /storage/emulated/0/Documents/Markor/photo_manifest.md"
          }
        }
      ]
    },
    {
      "device_id": "android_1",
      "config": [
        {
          "type": "adb_shell",
          "parameters": {
            "command": "rm -f /sdcard/Pictures/Site/north_gate.png /sdcard/Pictures/Site/meter_panel.png /sdcard/Pictures/Site/old_notice.png && content delete --uri content://media/external/images/media --where \"_display_name='north_gate.png'\" >/dev/null 2>&1 || true && content delete --uri content://media/external/images/media --where \"_display_name='meter_panel.png'\" >/dev/null 2>&1 || true && content delete --uri content://media/external/images/media --where \"_display_name='old_notice.png'\" >/dev/null 2>&1 || true && rmdir /sdcard/Pictures/Site 2>/dev/null || true"
          }
        },
        {
          "type": "adb_shell",
          "parameters": {
            "command": "rm -f /storage/emulated/0/Documents/Markor/photo_status.md /storage/emulated/0/Documents/Markor/Markor/photo_status.md"
          }
        }
      ]
    }
  ],
