        {
          "type": "androidworld_files_directory_preflight",
          "parameters": {
            "directory": "/sdcard/Recordings",
            "expected_filenames": [
              "gate_brief_present.mp3"
            ],
            "missing_filenames": [
              "gate_brief_missing.mp3"
            ]
          }
        },
        {
          "type": "androidworld_filesystem_snapshot",
          "parameters": {
            "snapshot_id": "android_only_305_recordings",
            "directories": [],
            "files": [
              "/sdcard/Recordings/gate_brief_present.mp3",
              "/sdcard/Recordings/gate_brief_missing.mp3"
            ]
          }
        },
        {
          "type": "ensure_app",
          "parameters": {
            "app": "markor"
          }
        },
        {
          "type": "adb_shell",
          "parameters": {
            "command": "rm -f '/storage/emulated/0/Documents/Markor/recording request status.md'"
          }
        }
      ]
    }
  ],
