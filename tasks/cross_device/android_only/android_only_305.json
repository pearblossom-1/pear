        },
        {
          "type": "adb_shell",
          "parameters": {
            "command": "am broadcast -a android.intent.action.MEDIA_SCANNER_SCAN_FILE -d file:///sdcard/Recordings/gate_brief_present.mp3 >/dev/null 2>&1 || true"
          }
