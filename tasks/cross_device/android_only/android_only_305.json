        {
          "type": "adb_shell",
          "parameters": {
            "command": "mkdir -p /sdcard/Recordings && rm -f /sdcard/Recordings/gate_brief_present.mp3 /sdcard/Recordings/gate_brief_missing.mp3 && content delete --uri content://media/external/audio/media --where \"_display_name='gate_brief_present.mp3'\" >/dev/null 2>&1 || true && content delete --uri content://media/external/audio/media --where \"_display_name='gate_brief_missing.mp3'\" >/dev/null 2>&1 || true"
