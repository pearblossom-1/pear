            "songs": [
              "gate_brief_present"
            ]
          }
        },
        {
          "type": "adb_shell",
          "parameters": {
            "command": "mv /sdcard/Music/gate_brief_present.mp3 /sdcard/Recordings/gate_brief_present.mp3"
