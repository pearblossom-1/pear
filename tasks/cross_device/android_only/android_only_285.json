{
  "id": "android_only_285",
  "instruction": "Open `music_export_manifest.csv` in Downloads on the first phone. On the second phone, use Files to copy each listed MP3 that exists from Music into `Music/Export`. Leave unlisted files alone and do not create missing files. Then create a Markor note on the second phone and save it as `Music export report.md`, marking each listed file as copied or missing.",
  "devices": [
    {
      "id": "android_0",
      "type": "android"
    },
    {
      "id": "android_1",
      "type": "android"
    }
  ],
  "variables": {},
  "setup": [
    {
      "device_id": "android_0",
      "config": [
        {
          "type": "ensure_app",
          "parameters": {
            "app": "files"
          }
        },
        {
          "type": "upload_file",
          "parameters": {
            "files": [
              {
                "local_path": "${repo_root}/tasks/cross_device/android_only_assets/android_only_285/android_0/files/music_export_manifest.csv",
                "path": "/sdcard/Download/music_export_manifest.csv"
              }
            ]
          }
        },
        {
          "type": "androidworld_files_directory_preflight",
          "parameters": {
            "directory": "/sdcard/Download",
            "expected_filenames": [
              "music_export_manifest.csv"
            ],
            "missing_filenames": [],
            "open_filename": "music_export_manifest.csv",
            "required_visible_text": [
              "north_loop.mp3",
              "bridge_check.mp3",
              "missing_song.mp3"
            ]
          }
        }
      ]
    },
    {
      "device_id": "android_1",
      "config": [
        {
          "type": "ensure_app",
          "parameters": {
            "app": "files"
          }
        },
        {
          "type": "ensure_app",
          "parameters": {
            "app": "markor"
          }
        },
        {
          "type": "adb_shell",
          "parameters": {
            "command": "rm -rf /sdcard/Music/Export && mkdir -p /sdcard/Music/Export && rm -f /sdcard/Music/north_loop.mp3 /sdcard/Music/bridge_check.mp3 /sdcard/Music/unlisted.mp3 /sdcard/Music/missing_song.mp3 '/storage/emulated/0/Documents/Markor/Music export report.md' && content delete --uri content://media/external/audio/media --where \"_display_name='north_loop.mp3'\" >/dev/null 2>&1 || true && content delete --uri content://media/external/audio/media --where \"_display_name='bridge_check.mp3'\" >/dev/null 2>&1 || true && content delete --uri content://media/external/audio/media --where \"_display_name='unlisted.mp3'\" >/dev/null 2>&1 || true && content delete --uri content://media/external/audio/media --where \"_display_name='missing_song.mp3'\" >/dev/null 2>&1 || true"
          }
        },
        {
          "type": "ensure_app",
          "parameters": {
            "app": "retro music"
          }
        },
        {
          "type": "androidworld_mp3_push",
          "parameters": {
            "songs": [
              "north_loop",
              "bridge_check",
              "unlisted"
            ]
          }
        },
        {
          "type": "androidworld_files_directory_preflight",
          "parameters": {
            "directory": "/sdcard/Music",
            "expected_filenames": [
              "north_loop.mp3",
              "bridge_check.mp3",
              "unlisted.mp3"
            ],
            "missing_filenames": [
              "missing_song.mp3"
            ]
          }
        },
        {
          "type": "androidworld_filesystem_snapshot",
          "parameters": {
            "snapshot_id": "android_only_285_music_sources",
            "directories": [],
            "files": [
              "/sdcard/Music/north_loop.mp3",
              "/sdcard/Music/bridge_check.mp3",
              "/sdcard/Music/unlisted.mp3",
              "/sdcard/Music/missing_song.mp3"
            ]
          }
        }
      ]
    }
  ],
  "cleanup": [
    {
      "device_id": "android_0",
      "config": [
        {
          "type": "adb_shell",
          "parameters": {
            "command": "rm -f /sdcard/Download/music_export_manifest.csv"
          }
        }
      ]
    },
    {
      "device_id": "android_1",
      "config": [
        {
          "type": "adb_shell",
          "parameters": {
            "command": "rm -rf /sdcard/Music/Export && rm -f /sdcard/Music/north_loop.mp3 /sdcard/Music/bridge_check.mp3 /sdcard/Music/unlisted.mp3 /sdcard/Music/missing_song.mp3 '/storage/emulated/0/Documents/Markor/Music export report.md' && content delete --uri content://media/external/audio/media --where \"_display_name='north_loop.mp3'\" >/dev/null 2>&1 || true && content delete --uri content://media/external/audio/media --where \"_display_name='bridge_check.mp3'\" >/dev/null 2>&1 || true && content delete --uri content://media/external/audio/media --where \"_display_name='unlisted.mp3'\" >/dev/null 2>&1 || true && content delete --uri content://media/external/audio/media --where \"_display_name='missing_song.mp3'\" >/dev/null 2>&1 || true"
          }
        }
      ]
    }
  ],
  "evaluation": [
