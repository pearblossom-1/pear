      "name": "Report copied and missing manifest entries without false exports",
      "device_id": "android_1",
      "func": "exact_match",
      "result": {
        "type": "android_entity_relation_note",
        "path": "/storage/emulated/0/Documents/Markor/Music export report.md",
        "rules": {
          "entities": [
            "north_loop.mp3",
            "bridge_check.mp3",
            "missing_song.mp3"
