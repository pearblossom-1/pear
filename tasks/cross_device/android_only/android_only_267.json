{
  "id": "android_only_267",
  "instruction": "The first phone's `audio_manifest.csv` is the recording checklist. Check the Recordings folder on the second phone, then text Status Contact from that phone with the checklist name, the number of listed recordings present, and any missing filename.",
  "devices": [
    {
      "id": "android_0",
      "type": "android"
    },
    {
      "id": "android_1",
      "type": "android"
    }
  ],
  "variables": {},
  "setup": [
    {
      "device_id": "android_0",
      "config": [
        {
          "type": "ensure_app",
          "parameters": {
            "app": "files"
          }
        },
        {
          "type": "upload_file",
          "parameters": {
            "files": [
              {
                "local_path": "${repo_root}/tasks/cross_device/android_only_assets/android_only_267/android_0/files/audio_manifest.csv",
                "path": "/sdcard/Download/audio_manifest.csv"
              }
            ]
          }
        },
        {
          "type": "androidworld_files_directory_preflight",
          "parameters": {
            "directory": "/sdcard/Download",
            "expected_filenames": [
              "audio_manifest.csv"
            ],
            "missing_filenames": [],
            "open_filename": "audio_manifest.csv",
            "required_visible_text": [
              "brief_a.mp3",
              "brief_b.mp3",
              "brief_c.mp3"
            ]
          }
        }
      ]
    },
    {
      "device_id": "android_1",
      "config": [
        {
          "type": "ensure_app",
          "parameters": {
            "app": "files"
          }
        },
        {
          "type": "adb_shell",
          "parameters": {
            "command": "mkdir -p /sdcard/Recordings && rm -f /sdcard/Recordings/brief_a.mp3 /sdcard/Recordings/brief_b.mp3 /sdcard/Recordings/brief_c.mp3 && content delete --uri content://media/external/audio/media --where \"_display_name='brief_a.mp3'\" >/dev/null 2>&1 || true && content delete --uri content://media/external/audio/media --where \"_display_name='brief_b.mp3'\" >/dev/null 2>&1 || true && content delete --uri content://media/external/audio/media --where \"_display_name='brief_c.mp3'\" >/dev/null 2>&1 || true"
          }
        },
        {
          "type": "ensure_app",
          "parameters": {
            "app": "retro music"
          }
        },
        {
          "type": "androidworld_mp3_push",
          "parameters": {
            "songs": [
              "brief_a",
              "brief_b"
            ]
          }
        },
        {
          "type": "adb_shell",
          "parameters": {
            "command": "mv /sdcard/Music/brief_a.mp3 /sdcard/Recordings/brief_a.mp3 && mv /sdcard/Music/brief_b.mp3 /sdcard/Recordings/brief_b.mp3"
          }
        },
        {
          "type": "adb_shell",
          "parameters": {
            "command": "am broadcast -a android.intent.action.MEDIA_SCANNER_SCAN_FILE -d file:///sdcard/Recordings/brief_a.mp3 >/dev/null 2>&1 || true && am broadcast -a android.intent.action.MEDIA_SCANNER_SCAN_FILE -d file:///sdcard/Recordings/brief_b.mp3 >/dev/null 2>&1 || true"
          }
        },
        {
          "type": "androidworld_files_directory_preflight",
          "parameters": {
            "directory": "/sdcard/Recordings",
            "expected_filenames": [
              "brief_a.mp3",
              "brief_b.mp3"
            ],
            "missing_filenames": [
              "brief_c.mp3"
            ]
          }
        },
        {
          "type": "androidworld_filesystem_snapshot",
          "parameters": {
            "snapshot_id": "android_only_267_recordings",
            "directories": [],
            "files": [
              "/sdcard/Recordings/brief_a.mp3",
              "/sdcard/Recordings/brief_b.mp3",
              "/sdcard/Recordings/brief_c.mp3"
            ]
          }
        },
        {
          "type": "ensure_app",
          "parameters": {
            "app": "contacts"
          }
        },
        {
          "type": "androidworld_contacts_clear",
          "parameters": {}
        },
        {
          "type": "androidworld_contact_add",
          "parameters": {
            "name": "Status Contact",
            "number": "5550267",
            "notes": "Receives recording status."
          }
        },
        {
          "type": "androidworld_contact_preflight",
          "parameters": {
            "contact": {
              "name": "Status Contact",
              "number": "5550267",
              "notes_exact": "Receives recording status.",
              "require_exactly_one": true
            },
            "required_visible_text": [
              "Status Contact",
              "5550267"
            ]
          }
        },
        {
          "type": "ensure_app",
          "parameters": {
            "app": "simple sms messenger"
          }
        },
        {
          "type": "androidworld_sms_clear",
          "parameters": {}
        }
      ]
    }
  ],
  "cleanup": [
    {
      "device_id": "android_0",
      "config": [
        {
          "type": "adb_shell",
          "parameters": {
            "command": "rm -f /sdcard/Download/audio_manifest.csv"
