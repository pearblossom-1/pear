{
  "id": "linux_smarthome_062",
  "instruction": "Set up the bedroom for the night — the note in `/tmp/home/docs/night-note.txt` has the details.",
  "devices": [
    {
      "id": "linux_0",
      "type": "linux"
    },
    {
      "id": "home_0",
      "type": "home"
    }
  ],
  "setup": [
    {
      "device_id": "linux_0",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "rm -f -- /tmp/home/docs/night-note.txt && mkdir -p -- /tmp/home/docs",
            "shell": true
          }
        },
        {
          "type": "upload_file",
          "parameters": {
            "files": [
              {
                "local_path": "${repo_root}/tasks/cross_device/linux_smarthome_assets/linux_smarthome_062/source/tmp/home/docs/night-note.txt",
                "path": "/tmp/home/docs/night-note.txt"
              }
            ]
          }
        }
      ]
    },
    {
      "device_id": "home_0",
      "config": [
        {
          "type": "smarthome.reset",
          "parameters": {
            "episode_config_ref": "tasks/cross_device/linux_smarthome_assets/linux_smarthome_062/episode_config.json"
          }
        }
      ]
    }
  ],
  "cleanup": [
    {
      "device_id": "linux_0",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "rm -f -- /tmp/home/docs/night-note.txt; rmdir --ignore-fail-on-non-empty /tmp/home/docs /tmp/home 2>/dev/null || true",
            "shell": true
          }
        }
      ]
    },
    {
      "device_id": "home_0",
      "config": [
        {
          "type": "smarthome.reset",
          "parameters": {}
        }
      ]
    }
  ],
  "evaluation": [
    {
      "device_id": "home_0",
      "func": "smarthome.check_allowed_state_diff",
      "result": {
        "type": "smarthome_home_state"
      },
      "expected": {
        "type": "rule",
        "rules": {
          "expected": {
            "allowed_device_field_changes": {
              "bedroom_curtain_1": {
                "open_pct": 0,
                "status": "closed"
              },
              "bedroom_dimmable_light_1": {
                "brightness_pct": 20
              }
            },
            "preserve_schedules": true,
            "preserve_workflows": true,
            "preserve_answer_reports": true,
            "preserve_infeasible_reports": true
          }
        }
      }
    }
  ],
  "limits": {
    "max_steps": 50
  },
  "metadata": {
    "category": "linux_smarthome",
    "source_idea": "linux_smarthome_idea_062",
    "surfaces": [
