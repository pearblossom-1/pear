{
  "id": "linux_smarthome_370",
  "instruction": "Grade the SmartHome air quality using the thresholds in `/tmp/air/thresholds.pdf` and save the worst readings to `/tmp/air/worst.json`.",
  "devices": [
    {
      "id": "linux_0",
      "type": "linux"
    },
    {
      "id": "home_0",
      "type": "home"
    }
  ],
  "setup": [
    {
      "device_id": "linux_0",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "rm -f -- /tmp/air/thresholds.pdf /tmp/air/worst.json && mkdir -p -- /tmp/air",
            "shell": true
          }
        },
        {
          "type": "upload_file",
          "parameters": {
            "files": [
              {
                "local_path": "${repo_root}/tasks/cross_device/linux_smarthome_assets/linux_smarthome_370/source/tmp/air/thresholds.pdf",
                "path": "/tmp/air/thresholds.pdf"
              }
            ]
          }
        }
      ]
    },
    {
      "device_id": "home_0",
      "config": [
        {
          "type": "smarthome.reset",
          "parameters": {
            "episode_config_ref": "tasks/cross_device/linux_smarthome_assets/linux_smarthome_370/episode_config.json"
          }
        }
      ]
    }
  ],
  "cleanup": [
    {
      "device_id": "linux_0",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "rm -f -- /tmp/air/thresholds.pdf /tmp/air/worst.json; find /tmp/air -type d -empty -delete 2>/dev/null || true",
            "shell": true
          }
        }
      ]
    },
    {
      "device_id": "home_0",
      "config": [
        {
          "type": "smarthome.reset",
          "parameters": {}
        }
      ]
    }
  ],
  "evaluation": [
    {
      "device_id": "linux_0",
      "func": "check_json_semantic_report",
      "result": {
        "type": "vm_file",
        "path": "/tmp/air/worst.json"
      },
      "expected": {
        "type": "rule",
        "rules": {
          "exact_fields": {
            "pm25": 97
          },
          "semantic_fields": {
            "room": {
              "include": [
                "garage"
              ],
              "case_sensitive": false,
              "entity_relation": {
                "entities": [
                  "garage"
                ],
                "conflict_phrases": [
                  "not garage",
                  "unknown room"
                ]
              }
            },
            "grade": {
              "include": [
                "critical"
              ],
              "case_sensitive": false,
              "entity_relation": {
                "entities": [
                  "critical"
                ],
                "conflict_phrases": [
                  "not critical",
                  "non-critical"
                ]
              }
            }
          },
          "field_aliases": {},
          "allowed_extra_fields": []
        }
      },
      "metadata": {
        "path": "/tmp/air/worst.json"
      }
    },
    {
      "device_id": "home_0",
      "func": "smarthome.check_no_home_mutation",
      "enable_score_calc": false,
      "result": {
        "type": "smarthome_home_state"
      },
      "expected": {
        "type": "rule",
        "rules": {
          "expected": {
            "all_devices": true,
            "preserve_schedules": true,
            "preserve_workflows": true,
            "preserve_answer_reports": true,
            "preserve_infeasible_reports": true
