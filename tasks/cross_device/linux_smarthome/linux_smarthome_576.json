        {
          "type": "execute",
          "parameters": {
            "command": "rm -f -- /tmp/climate/cooling.md /tmp/climate/decision.json; find /tmp/climate -type d -empty -delete 2>/dev/null || true",
            "shell": true
          }
        }
      ]
    },
    {
      "device_id": "home_0",
      "config": [
        {
          "type": "smarthome.reset",
