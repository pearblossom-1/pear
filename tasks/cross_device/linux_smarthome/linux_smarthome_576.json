        {
          "type": "execute",
          "parameters": {
            "command": "rm -f -- /tmp/climate/cooling.md /tmp/climate/decision.json && mkdir -p -- /tmp/climate",
            "shell": true
          }
        },
        {
          "type": "upload_file",
          "parameters": {
