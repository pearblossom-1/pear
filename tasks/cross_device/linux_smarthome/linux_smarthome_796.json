            "shell": true
          }
        }
      ]
    },
    {
      "device_id": "linux_1",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "rm -f -- /tmp/assets/audit.xlsx; find /tmp/assets -type d -empty -delete 2>/dev/null || true",
            "shell": true
          }
        }
      ]
