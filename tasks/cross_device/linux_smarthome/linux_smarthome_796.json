{
  "id": "linux_smarthome_796",
  "instruction": "`/home/user/assets/labels.csv` on the first Linux machine lists the asset IDs, and `/tmp/assets/audit.xlsx` on the second Linux machine is the audit workbook. Query Home capabilities and complete the reconciliation.",
  "devices": [
    {
      "id": "linux_0",
      "type": "linux"
    },
    {
      "id": "linux_1",
      "type": "linux"
    },
    {
      "id": "home_0",
      "type": "home"
    }
  ],
  "setup": [
    {
      "device_id": "linux_0",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "rm -f -- /home/user/assets/labels.csv && mkdir -p -- /home/user/assets",
            "shell": true
          }
        },
        {
          "type": "upload_file",
          "parameters": {
            "files": [
              {
                "local_path": "${repo_root}/tasks/cross_device/linux_smarthome_assets/linux_smarthome_796/source/home/user/assets/labels.csv",
                "path": "/home/user/assets/labels.csv"
              }
            ]
          }
        }
      ]
    },
    {
      "device_id": "linux_1",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "rm -f -- /tmp/assets/audit.xlsx && mkdir -p -- /tmp/assets",
            "shell": true
          }
        },
        {
          "type": "upload_file",
          "parameters": {
            "files": [
              {
                "local_path": "${repo_root}/tasks/cross_device/linux_smarthome_assets/linux_smarthome_796/source/linux_1/tmp/assets/audit.xlsx",
                "path": "/tmp/assets/audit.xlsx"
              }
            ]
          }
        }
      ]
    },
    {
      "device_id": "home_0",
      "config": [
        {
          "type": "smarthome.reset",
          "parameters": {
            "episode_config_ref": "tasks/cross_device/linux_smarthome_assets/linux_smarthome_796/episode_config.json"
          }
        }
      ]
    }
  ],
  "cleanup": [
