  "setup": [
    {
      "device_id": "linux_0",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "rm -f -- /tmp/home/actions/room_prep.csv && mkdir -p -- /tmp/home/actions",
            "shell": true
          }
        },
        {
          "type": "upload_file",
          "parameters": {
            "files": [
