{
  "id": "linux_smarthome_520",
  "instruction": "On the first Linux desktop, read `/home/user/floor/zones.csv` for the area-code mapping and handling rules. The second Linux desktop has `/tmp/floor/requests.xlsx` with three area requests and parameters. Map each request to a Home room, carry out the requests that are allowed and supported, and save the completed register to `/tmp/floor/completed-register.xlsx`.",
  "devices": [
    {
      "id": "linux_0",
      "type": "linux"
    },
    {
      "id": "linux_1",
      "type": "linux"
    },
    {
      "id": "home_0",
      "type": "home"
    }
  ],
  "setup": [
    {
      "device_id": "linux_0",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "rm -f -- /home/user/floor/zones.csv && mkdir -p -- /home/user/floor",
            "shell": true
          }
        },
        {
          "type": "upload_file",
          "parameters": {
            "files": [
              {
                "local_path": "${repo_root}/tasks/cross_device/linux_smarthome_assets/linux_smarthome_520/source/home/user/floor/zones.csv",
                "path": "/home/user/floor/zones.csv"
              }
            ]
          }
        }
      ]
    },
    {
      "device_id": "linux_1",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "rm -f -- /tmp/floor/requests.xlsx /tmp/floor/completed-register.xlsx && mkdir -p -- /tmp/floor",
            "shell": true
          }
        },
        {
          "type": "upload_file",
          "parameters": {
            "files": [
              {
                "local_path": "${repo_root}/tasks/cross_device/linux_smarthome_assets/linux_smarthome_520/source/linux_1/tmp/floor/requests.xlsx",
                "path": "/tmp/floor/requests.xlsx"
              }
            ]
          }
        }
      ]
    },
    {
      "device_id": "home_0",
      "config": [
        {
          "type": "smarthome.reset",
          "parameters": {
            "episode_config_ref": "tasks/cross_device/linux_smarthome_assets/linux_smarthome_520/episode_config.json"
          }
        }
      ]
    }
  ],
  "cleanup": [
    {
      "device_id": "linux_0",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "rm -f -- /home/user/floor/zones.csv; find /home/user/floor -type d -empty -delete 2>/dev/null || true",
            "shell": true
          }
        }
      ]
    },
    {
      "device_id": "linux_1",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "rm -f -- /tmp/floor/completed-register.xlsx /tmp/floor/requests.xlsx; find /tmp/floor -type d -empty -delete 2>/dev/null || true",
            "shell": true
          }
        }
      ]
    },
    {
      "device_id": "home_0",
      "config": [
        {
          "type": "smarthome.reset",
          "parameters": {}
        }
      ]
    }
  ],
  "evaluation": [
    {
      "device_id": "home_0",
      "func": "smarthome.check_allowed_state_diff",
      "result": {
        "type": "smarthome_home_state"
      },
      "expected": {
        "type": "rule",
        "rules": {
          "expected": {
            "allowed_device_field_changes": {
              "office_dimmable_light_1": {
                "power": "on",
                "brightness_pct": 40
              }
            },
            "preserve_schedules": true,
            "preserve_workflows": true,
            "preserve_infeasible_reports": true,
            "preserve_answer_reports": true
          }
        }
      }
    },
    {
      "device_id": "linux_1",
      "func": "check_xlsx_cells",
      "result": {
        "type": "vm_file",
        "path": "/tmp/floor/completed-register.xlsx"
      },
      "expected": {
        "type": "rule",
        "rules": {
          "preserve_from": "tasks/cross_device/linux_smarthome_assets/linux_smarthome_520/source/linux_1/tmp/floor/requests.xlsx",
          "allowed_changes": [
            "Sheet1!D2",
            "Sheet1!E2",
            "Sheet1!F2",
            "Sheet1!G2",
            "Sheet1!D3",
            "Sheet1!E3",
            "Sheet1!F3",
            "Sheet1!G3",
            "Sheet1!D4",
            "Sheet1!E4",
            "Sheet1!F4",
            "Sheet1!G4"
          ],
          "cells": {
            "D2": "office",
            "E2": {
              "alternatives": [
                "office dimmable light",
                "office_dimmable_light_1"
              ]
            },
            "F2": "Executed",
            "D3": "bedroom",
            "E3": {
              "alternatives": [
                "bedroom curtain",
                "bedroom_curtain_1"
              ]
            },
            "F3": "Protected",
            "D4": "entry",
            "E4": {
              "alternatives": [
                "entry light",
                "entry_light_1"
              ]
            },
            "F4": "Rejected"
          },
          "cell_rules": {
            "G2": {
              "contains_all": [
                "40"
              ],
              "contains_any": [
                "set",
                "applied",
                "executed"
              ],
              "not_contains": [
                "not applied",
                "pending",
                "failed",
                "rejected"
              ]
            },
            "G3": {
              "entity_relation": {
                "entities": [
                  [
                    "protected",
                    "blocked"
                  ],
                  [
                    "room",
                    "bedroom",
                    "room policy",
                    "policy"
                  ]
                ],
                "conflict_phrases": [
                  "not protected",
                  "executed",
                  "applied"
                ],
                "reject_questions": true,
                "reject_uncertainty": true,
                "reject_negated_relations": true
              }
            },
            "G4": {
              "entity_relation": {
                "entities": [
                  [
                    "unsupported dimming",
                    "dimming unsupported",
                    "no brightness control",
                    "has no brightness control",
                    "on/off only",
                    "on off only"
                  ]
                ],
                "conflict_phrases": [
                  "supports dimming",
                  "brightness applied",
                  "executed"
                ],
                "reject_questions": true,
                "reject_uncertainty": true,
                "reject_negated_relations": true
              }
            }
          }
        }
      },
      "metadata": {
        "path": "/tmp/floor/completed-register.xlsx"
      }
    }
  ],
  "limits": {
    "max_steps": 50
  },
