{
  "id": "linux_smarthome_065",
  "instruction": "Start the laundry load according to the sheet at `/tmp/home/sheets/laundry.ods`.",
  "devices": [
    {
      "id": "linux_0",
      "type": "linux"
    },
    {
      "id": "home_0",
      "type": "home"
    }
  ],
  "setup": [
    {
      "device_id": "linux_0",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "rm -f -- /tmp/home/sheets/laundry.ods && mkdir -p -- /tmp/home/sheets",
            "shell": true
          }
        },
        {
          "type": "upload_file",
          "parameters": {
            "files": [
              {
                "local_path": "${repo_root}/tasks/cross_device/linux_smarthome_assets/linux_smarthome_065/source/tmp/home/sheets/laundry.ods",
                "path": "/tmp/home/sheets/laundry.ods"
              }
            ]
          }
        }
      ]
    },
    {
      "device_id": "home_0",
      "config": [
        {
          "type": "smarthome.reset",
          "parameters": {
            "episode_config_ref": "tasks/cross_device/linux_smarthome_assets/linux_smarthome_065/episode_config.json"
          }
        }
      ]
    }
  ],
  "cleanup": [
    {
      "device_id": "linux_0",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "rm -f -- /tmp/home/sheets/laundry.ods; find /tmp/home -type d -empty -delete 2>/dev/null || true",
            "shell": true
          }
        }
      ]
    },
    {
      "device_id": "home_0",
      "config": [
        {
          "type": "smarthome.reset",
          "parameters": {}
        }
      ]
    }
  ],
  "evaluation": [
    {
      "device_id": "home_0",
      "func": "smarthome.check_device_state",
      "result": {
