          "type": "execute",
          "parameters": {
            "command": "rm -f -- /tmp/protection/current-diagram.png /tmp/protection/current-manifest.json && mkdir -p -- /tmp/protection",
            "shell": true
          }
        },
        {
          "type": "upload_file",
          "parameters": {
            "files": [
              {
                "local_path": "${repo_root}/tasks/cross_device/linux_smarthome_assets/linux_smarthome_670/source/tmp/protection/current-diagram.png",
                "path": "/tmp/protection/current-diagram.png"
