          }
        }
      ]
    },
    {
      "device_id": "linux_1",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "rm -f -- /tmp/protection/plan-audit.xlsx && mkdir -p -- /tmp/protection",
            "shell": true
          }
