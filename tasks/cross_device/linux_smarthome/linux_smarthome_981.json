      "device_id": "linux_0",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "rm -f -- /tmp/window/policy.docx && mkdir -p -- /tmp/window",
            "shell": true
          }
        },
        {
          "type": "upload_file",
