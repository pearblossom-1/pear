              }
            ]
          }
        }
      ]
    },
    {
      "device_id": "linux_1",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "rm -f -- /tmp/window/board.xlsx && mkdir -p -- /tmp/window",
            "shell": true
          }
