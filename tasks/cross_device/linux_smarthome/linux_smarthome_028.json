{
  "id": "linux_smarthome_028",
  "instruction": "Apply the quiet-hours rule from `/tmp/home_plan/noise_quiet_hours.md` to the existing plans.",
  "devices": [
    {
      "id": "linux_0",
      "type": "linux"
    },
    {
      "id": "home_0",
      "type": "home"
    }
  ],
  "setup": [
    {
      "device_id": "linux_0",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "rm -f -- /tmp/home_plan/noise_quiet_hours.md && mkdir -p -- /tmp/home_plan",
            "shell": true
          }
        },
        {
          "type": "upload_file",
          "parameters": {
            "files": [
              {
                "local_path": "${repo_root}/tasks/cross_device/linux_smarthome_assets/linux_smarthome_028/source/noise_quiet_hours.md",
                "path": "/tmp/home_plan/noise_quiet_hours.md"
              }
            ]
          }
        }
      ]
    },
    {
      "device_id": "home_0",
      "config": [
        {
          "type": "smarthome.reset",
          "parameters": {
            "episode_config_ref": "tasks/cross_device/linux_smarthome_assets/linux_smarthome_028/episode_config.json"
          }
        }
      ]
    }
  ],
  "cleanup": [
    {
      "device_id": "linux_0",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "rm -f -- /tmp/home_plan/noise_quiet_hours.md; find /tmp/home_plan -type d -empty -delete 2>/dev/null || true",
            "shell": true
          }
        }
      ]
    },
    {
      "device_id": "home_0",
      "config": [
        {
          "type": "smarthome.reset",
          "parameters": {}
        }
      ]
    }
  ],
  "evaluation": [
    {
      "device_id": "home_0",
      "func": "smarthome.check_schedule_status",
      "result": {
        "type": "smarthome_schedules"
      },
      "expected": {
        "type": "rule",
        "rules": {
          "expected": {
            "schedule_id": "late_vacuum",
            "run_at": "2026-06-16T22:30:00",
            "device_id": "living_room_robot_vacuum_1",
            "command": "start_cleaning",
            "args": {},
            "status": "cancelled"
          }
        }
      },
      "name": "original late_vacuum schedule is cancelled in place"
    },
    {
      "device_id": "home_0",
      "func": "smarthome.check_schedule_count",
      "result": {
        "type": "smarthome_schedules"
      },
      "expected": {
        "type": "rule",
        "rules": {
          "expected": {
            "count": 1,
            "match": {}
          }
        }
      },
      "enable_score_calc": false,
      "name": "one schedule remains after cancellation"
    },
    {
      "device_id": "home_0",
      "func": "smarthome.check_workflow_count",
      "result": {
        "type": "smarthome_workflows"
      },
      "expected": {
        "type": "rule",
        "rules": {
          "expected": {
            "count": 0,
            "match": {}
          }
        }
      },
      "enable_score_calc": false,
      "name": "no replacement workflow is created"
    },
    {
      "device_id": "home_0",
      "func": "smarthome.check_command_history_count",
      "result": {
        "type": "smarthome_device_history"
      },
      "expected": {
        "type": "rule",
        "rules": {
          "expected": {
            "count": 0,
            "match": {}
          }
        }
      },
      "enable_score_calc": false,
      "name": "vacuum is not controlled immediately"
    },
    {
      "device_id": "home_0",
      "func": "smarthome.check_no_device_change",
      "result": {
        "type": "smarthome_home_state"
      },
      "expected": {
        "type": "rule",
        "rules": {
          "expected": {
            "device_id": "living_room_robot_vacuum_1"
          }
        }
      },
      "enable_score_calc": false,
      "name": "living-room robot baseline is preserved"
    }
  ],
  "limits": {
    "max_steps": 50
  },
