      "device_id": "linux_0",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "rm -f -- /tmp/capability/policy.html; find /tmp/capability -type d -empty -delete 2>/dev/null || true",
            "shell": true
          }
        }
      ]
    },
    {
      "device_id": "linux_1",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "rm -f -- /tmp/capability/board.xlsx; find /tmp/capability -type d -empty -delete 2>/dev/null || true",
            "shell": true
