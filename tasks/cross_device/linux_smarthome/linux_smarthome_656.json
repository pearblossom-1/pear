{
  "id": "linux_smarthome_656",
  "instruction": "Read `/tmp/climate/fallback_matrix.md`, check the listed rooms and live SmartHome capabilities, and apply the best permitted climate fallback for each room. Save the compact room-by-room handoff to `/tmp/climate/fallback_result.json` using the visible schema in the matrix, including the reason for any unavailable room.",
  "devices": [
    {
      "id": "linux_0",
      "type": "linux"
    },
    {
      "id": "home_0",
      "type": "home"
    }
  ],
  "setup": [
    {
      "device_id": "linux_0",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "rm -f -- /tmp/climate/fallback_matrix.md /tmp/climate/fallback_result.json && mkdir -p -- /tmp/climate",
            "shell": true
          }
        },
        {
          "type": "upload_file",
          "parameters": {
            "files": [
              {
                "local_path": "${repo_root}/tasks/cross_device/linux_smarthome_assets/linux_smarthome_656/source/tmp/climate/fallback_matrix.md",
                "path": "/tmp/climate/fallback_matrix.md"
              }
            ]
          }
        }
      ]
    },
    {
      "device_id": "home_0",
      "config": [
        {
          "type": "smarthome.reset",
          "parameters": {
            "episode_config_ref": "tasks/cross_device/linux_smarthome_assets/linux_smarthome_656/episode_config.json"
          }
        }
      ]
    }
  ],
  "cleanup": [
    {
      "device_id": "linux_0",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "rm -f -- /tmp/climate/fallback_matrix.md /tmp/climate/fallback_result.json; find /tmp/climate -type d -empty -delete 2>/dev/null || true",
            "shell": true
          }
        }
      ]
    },
    {
      "device_id": "home_0",
      "config": [
        {
          "type": "smarthome.reset",
          "parameters": {}
        }
      ]
    }
  ],
  "evaluation": [
    {
      "device_id": "home_0",
      "func": "smarthome.check_allowed_state_diff",
      "result": {
        "type": "smarthome_home_state"
      },
      "expected": {
        "type": "rule",
        "rules": {
          "expected": {
            "allowed_device_field_changes": {
              "office_air_conditioner_1": {
                "power": "on",
                "mode": "cool",
                "target_temperature_c": 24.0
              },
              "study_heater_1": {
                "power": "on"
              }
            },
            "preserve_schedules": true,
            "preserve_workflows": true,
            "preserve_answer_reports": true,
            "preserve_infeasible_reports": true
          }
        }
      }
    },
    {
      "device_id": "linux_0",
      "func": "check_json_exact_object",
      "result": {
        "type": "vm_file",
        "path": "/tmp/climate/fallback_result.json"
      },
      "expected": {
        "type": "rule",
        "rules": {
          "object": {
            "rooms": {
              "office": {
                "status": "applied",
                "device": "air conditioner",
                "target_c": 24
              },
              "study": {
                "status": "applied",
                "device": "heater",
                "target_c": 22
              },
              "guest room": {
                "status": "unavailable",
                "reason": "no climate device"
              }
            }
          }
        }
      },
      "metadata": {
        "path": "/tmp/climate/fallback_result.json"
      }
    }
  ],
  "limits": {
    "max_steps": 50
  },
