{
  "id": "al_calendar_schedule_conflict",
  "instruction": "This week's meeting schedule has conflicts: Android Simple Calendar Pro and Linux `/tmp/schedule/week.csv` disagree on details for meetings with the same names. `/tmp/schedule/rule.txt` explains which source is authoritative and which fields should be synchronized. Please correct the CSV accordingly and write `/tmp/schedule/log.json` documenting the fields that changed, including their old and new values.",
  "devices": [
    {
      "id": "android_0",
      "type": "android"
    },
    {
      "id": "linux_0",
      "type": "linux"
    }
  ],
  "variables": {
    "week_csv": "/tmp/schedule/week.csv",
    "log_json": "/tmp/schedule/log.json"
  },
  "setup": [
    {
      "device_id": "android_0",
      "config": [
        {
          "type": "ensure_app",
          "parameters": {
            "app": "simple calendar pro"
          }
        },
        {
          "type": "androidworld_calendar_clear",
          "parameters": {}
        },
        {
          "type": "androidworld_calendar_event_add",
          "parameters": {
            "title": "Vendor planning",
            "start_ts": 1802530800,
            "end_ts": 1802534400,
            "location": "Room 8",
            "description": "Source of truth for schedule correction"
          }
        }
      ]
    },
    {
      "device_id": "linux_0",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "rm -rf /tmp/schedule && mkdir -p /tmp/schedule",
            "shell": true
          }
        },
        {
          "type": "upload_file",
          "parameters": {
            "files": [
              {
                "local_path": "${repo_root}/tasks/cross_device/real100_assets/al_calendar_schedule_conflict/source/week.csv",
                "path": "/tmp/schedule/week.csv"
              },
              {
                "local_path": "${repo_root}/tasks/cross_device/real100_assets/al_calendar_schedule_conflict/source/rule.txt",
                "path": "/tmp/schedule/rule.txt"
              }
            ]
          }
        },
        {
          "type": "execute",
          "parameters": {
            "command": "test -r /tmp/schedule/week.csv && test -w /tmp/schedule/week.csv && test -r /tmp/schedule/rule.txt && test -w /tmp/schedule && test ! -e /tmp/schedule/log.json",
            "shell": true
          }
        }
      ]
    }
  ],
  "cleanup": [
    {
      "device_id": "android_0",
      "config": [
        {
          "type": "androidworld_calendar_clear",
          "parameters": {}
        }
      ]
    },
    {
      "device_id": "linux_0",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "rm -rf /tmp/schedule",
            "shell": true
          }
        }
      ]
    }
  ],
  "evaluation": [
    {
      "device_id": "linux_0",
      "func": "check_semantic_change",
      "result": {
        "type": "vm_file",
        "path": "${log_json}"
      },
      "expected": {
        "type": "rule",
        "rules": {
          "format": "json",
          "relation_mode": "field_change_set",
          "require_affirmative": true,
          "entity": "Vendor planning",
          "forbidden_change_entities": [
            "Ops sync"
          ],
          "old": {
            "start": "09:00",
            "end": "10:00",
            "location": "Room 2"
          },
          "new": {
            "start": "15:00",
            "end": "16:00",
            "location": "Room 8"
          },
          "field_groups": [
            {
              "name": "time",
              "aliases": [
                "start",
                "end"
              ],
              "old": [
                "09:00",
                "10:00"
              ],
              "new": [
                "15:00",
                "16:00"
              ],
              "value_pattern": "(?<![0-9])\\d{1,2}:\\d{2}(?![0-9])"
            },
            {
              "name": "location",
              "aliases": [],
              "old": [
                "Room 2"
              ],
              "new": [
                "Room 8"
              ],
              "value_pattern": "\\broom\\s+\\d+\\b"
            }
          ]
        }
      }
    },
    {
      "device_id": "linux_0",
      "func": "check_csv",
      "result": {
        "type": "vm_file",
        "path": "${week_csv}"
      },
      "expected": {
        "type": "rule",
        "rules": {
          "exact_logical_rows": true,
        "order_sensitive": false,
          "columns": [
            "title",
            "date",
            "start",
            "end",
            "location"
          ],
          "rows": [
            {
              "title": "Vendor planning",
              "date": "2027-02-13",
              "start": "15:00",
              "end": "16:00",
              "location": "Room 8"
            },
            {
              "title": "Ops sync",
              "date": "2027-02-14",
              "start": "11:00",
              "end": "11:30",
              "location": "Room 4"
            }
          ]
        }
      }
    }
  ],
  "limits": {
    "max_steps": 26,
    "max_wall_time_s": 260
  },
  "metadata": {
    "category": "real100_cross_device",
    "source_card": "062",
    "difficulty": "Complex",
    "motif": "M6",
    "surfaces": "Android Simple Calendar Pro + Linux schedule -> Linux corrected CSV + log",
    "setup_note": "Android 写入 source-of-truth Calendar；Linux 上传完整 reconciliation rule 与不一致 CSV，清理 log，并校验输入可读、CSV/目录可写。",
    "evaluate_note": "Checks the exact corrected logical CSV and requires the complete Vendor planning time and location change set in log.json, accepting nested maps, change lists, or flattened old/new fields plus harmless metadata.",
    "device_topology": "1A+1L",
    "implementation_status": "real_evaluator",
    "readiness": "R1_native_real_fixture",
    "cross_device_checks": [
      "linux_schedule_csv_and_log_follow_android_calendar_source_of_truth"
    ],
    "asset_source": "tasks/cross_device/real100_assets/al_calendar_schedule_conflict/source",
    "lite_evaluator_hardening_note": "The field-change-set mode binds Vendor planning to both required changes: 09:00-10:00 -> 15:00-16:00 and Room 2 -> Room 8. It accepts the three visible JSON organizations in the repair spec and harmless source/note/update metadata, while rejecting reversed values, missing fields, unexpected room/time values, or an Ops sync change record."
  }
}
