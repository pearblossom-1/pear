{
  "id": "al_request_audio",
  "instruction": "`/tmp/brief/request.txt` on Linux gives the filename, format, and public save location for a voice memo. Please use Android Audio Recorder to record a short audio clip and save or export it as requested. You may use Android Files to place the finished recording in the requested public folder.",
  "devices": [
    {
      "id": "android_0",
      "type": "android"
    },
    {
      "id": "linux_0",
      "type": "linux"
    }
  ],
  "variables": {
    "memo_path": "/storage/emulated/0/Recordings/briefing.m4a"
  },
  "setup": [
    {
      "device_id": "android_0",
      "config": [
        {
          "type": "ensure_app",
          "parameters": {
            "app": "audio recorder"
          }
        },
        {
          "type": "ensure_app",
          "parameters": {
            "app": "android files"
          }
        },
        {
          "type": "androidworld_media_isolate",
          "parameters": {
            "kind": "audio_recorder",
            "namespace": "real100_al_request_audio"
          }
        },
        {
          "type": "androidworld_media_isolate",
          "parameters": {
            "kind": "shared_recordings",
            "namespace": "real100_al_request_audio_exports"
          }
        },
        {
          "type": "adb_shell",
          "parameters": {
            "command": "content delete --uri content://media/external/audio/media --where \"_display_name='briefing.m4a' AND relative_path='Recordings/'\" >/dev/null 2>&1 || true; mkdir -p /sdcard/Recordings; rm -f '${memo_path}'",
            "check_exit_status": true
          }
        }
      ]
    },
    {
      "device_id": "linux_0",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "rm -rf /tmp/brief && mkdir -p /tmp/brief",
            "shell": true
          }
        },
        {
          "type": "upload_file",
          "parameters": {
            "files": [
              {
                "local_path": "${repo_root}/tasks/cross_device/real100_assets/al_request_audio/source/request.txt",
                "path": "/tmp/brief/request.txt"
              }
            ]
          }
        },
        {
          "type": "execute",
          "parameters": {
            "command": "test -r /tmp/brief/request.txt",
            "shell": true
          }
        }
      ]
    }
  ],
  "cleanup": [
    {
      "device_id": "android_0",
      "config": [
        {
          "type": "adb_shell",
          "parameters": {
            "command": "content delete --uri content://media/external/audio/media --where \"_display_name='briefing.m4a' AND relative_path='Recordings/'\" >/dev/null 2>&1 || true; rm -f '${memo_path}'; rmdir /sdcard/Recordings 2>/dev/null || true",
            "check_exit_status": true
          }
        },
        {
          "type": "androidworld_media_restore",
          "parameters": {
            "kind": "shared_recordings",
            "namespace": "real100_al_request_audio_exports"
          }
        },
        {
          "type": "androidworld_media_restore",
          "parameters": {
            "kind": "audio_recorder",
            "namespace": "real100_al_request_audio"
          }
        }
      ]
    },
    {
      "device_id": "linux_0",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "rm -rf /tmp/brief",
            "shell": true
          }
        }
      ]
    }
  ],
  "evaluation": [
    {
      "device_id": "android_0",
      "func": "exact_match",
      "result": {
        "type": "android_audio_file_state",
        "path": "${memo_path}",
        "allowed_formats": [
          "mov",
          "mp4",
          "m4a",
          "3gp"
        ],
        "allowed_codecs": [
          "aac",
          "alac"
        ],
        "min_duration_s": 0.25
      },
      "expected": {
        "type": "rule",
        "rules": {
          "expected": "valid"
        }
      }
    }
  ],
  "limits": {
    "max_steps": 22,
    "max_wall_time_s": 220
  },
  "metadata": {
    "category": "real100_cross_device",
    "source_card": "037",
    "readiness": "R1_native_real_fixture",
    "device_topology": "1A+1L",
    "android_surfaces": [
      "Audio Recorder",
      "Android Files"
    ],
    "linux_surfaces": [
      "text"
    ],
    "implementation_status": "real_evaluator",
    "cross_device_checks": [
      "real100_card_037_adapted_from_briefing_voice_memo_001",
      "named_audio_file_matches_linux_request"
    ],
    "asset_source": "tasks/cross_device/real100_assets/al_request_audio/source",
    "difficulty": "Simple",
    "motif": "M3",
    "surfaces": "Linux text -> Android Audio Recorder recording -> public Android Recordings file",
    "setup_note": "Linux uploads request.txt; Android isolates and later restores both existing Audio Recorder media and the public Recordings tree, then prepares only the requested output path.",
    "evaluate_note": "Pulls /sdcard/Recordings/briefing.m4a and uses ffprobe to require a real M4A/MP4-family container with a decodable AAC/ALAC audio stream, packets, and positive duration.",
    "template_source": "tasks/cross_device/real20/briefing_voice_memo_001.json",
    "capabilities": [
      "audio recording",
      "cross-device request following",
      "file naming and public export",
      "media handling"
    ],
    "lite_evaluator_hardening_note": "The evaluator rejects non-audio text or fake archives renamed .m4a and requires a decodable positive-duration recording at the disclosed public Recordings path. The oracle synthesizes and uploads a valid AAC/M4A artifact. Existing Audio Recorder media and the public Recordings tree are isolated and restored rather than broadly deleted."
  }
}
