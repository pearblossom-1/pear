{
  "id": "linux_android_1858",
  "instruction": "Cross-check the latest Simple SMS Messenger request against the current row in `/tmp/contacts/recipient_table.csv` on the first Linux desktop. If their phone values conflict, write `/tmp/communication/communication_status.md` on the second Linux desktop with the case, approval code, owner, both phone values, and why no reply can be sent. Do not send a reply or confirmation to either phone value.",
  "devices": [
    {
      "id": "android_0",
      "type": "android"
    },
    {
      "id": "linux_0",
      "type": "linux"
    },
    {
      "id": "linux_1",
      "type": "linux"
    }
  ],
  "variables": {},
  "setup": [
    {
      "device_id": "android_0",
      "config": [
        {
          "type": "ensure_app",
          "parameters": {
            "app": "simple sms messenger"
          }
        },
        {
          "type": "androidworld_sms_clear",
          "parameters": {}
        },
        {
          "type": "androidworld_sms_receive",
          "parameters": {
            "address": "+15552001828",
            "body": "Archived request OLD-17; ignore this older message.",
            "wait_s": 2.1
          }
        },
        {
          "type": "androidworld_sms_receive",
          "parameters": {
            "address": "+15552001828",
            "body": "Latest approval CASE-1858 FB-1858 for Leo Martin at 2026-07-23 09:40.",
            "wait_s": 2.1
          }
        },
        {
          "type": "adb_shell",
          "parameters": {
            "command": "rows=\"$(content query --uri content://sms/inbox --projection address:body --where \"address='+15552001828'\" --sort 'date DESC,_id DESC' 2>/dev/null)\"; test \"$(printf '%s\\n' \"$rows\" | grep -c '^Row:')\" -eq 2 && latest=\"$(printf '%s\\n' \"$rows\" | sed -n '1p')\" && printf '%s\\n' \"$latest\" | grep -F 'address=+15552001828' >/dev/null && printf '%s\\n' \"$latest\" | grep -F 'body=Latest approval CASE-1858 FB-1858 for Leo Martin at 2026-07-23 09:40.' >/dev/null && sent=\"$(content query --uri content://sms/sent --projection address:body 2>/dev/null)\" && ! printf '%s\\n' \"$sent\" | grep -q '^Row:'",
            "check_exit_status": true
          }
        },
        {
          "type": "open_app",
          "parameters": {
            "app": "simple sms messenger"
          }
        }
      ]
    },
    {
      "device_id": "linux_0",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "mkdir -p /tmp/contacts && rm -f /tmp/contacts/recipient_table.csv",
            "shell": true
          }
        },
        {
          "type": "upload_file",
          "parameters": {
            "files": [
              {
                "local_path": "${repo_root}/tasks/cross_device/linux_android_assets/linux_android_1858/source/recipient_table.csv",
                "path": "/tmp/contacts/recipient_table.csv"
              }
            ]
          }
        },
        {
          "type": "execute",
          "parameters": {
            "command": "set -e\nfile=/tmp/contacts/recipient_table.csv\ntest -r \"$file\"\nhead -n 1 \"$file\" | grep -Fx 'case,status,code,owner,phone,email,route,site,time,filename,include,notes' >/dev/null\ntest \"$(awk -F, 'NR > 1 && $2 == \"current\" && $11 == \"yes\" { count++ } END { print count + 0 }' \"$file\")\" -eq 1\nawk -F, 'NR > 1 && $1 == \"CASE-1858\" && $2 == \"current\" && $3 == \"FB-1858\" && $4 == \"Leo Martin\" && $5 == \"+15552009928\" && $11 == \"yes\" { ok = 1 } END { exit !ok }' \"$file\"",
            "shell": true
          }
        }
      ]
    },
    {
      "device_id": "linux_1",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "set -e\nmkdir -p /tmp/communication\nrm -f /tmp/communication/communication_status.md\ntest -w /tmp/communication\ntest ! -e /tmp/communication/communication_status.md",
            "shell": true
          }
        }
      ]
    }
  ],
  "cleanup": [
    {
      "device_id": "android_0",
      "config": [
        {
          "type": "androidworld_sms_clear",
          "parameters": {}
        }
      ]
    },
    {
      "device_id": "linux_0",
