{
  "id": "linux_android_1234",
  "instruction": "Take the latest phone status text, map it through `/tmp/status/status_map.csv`, and create `/tmp/status/normalized_status.json` for the downstream status importer. Use exactly four string fields: `message_timestamp`, `raw_phrase`, `canonical_status`, and `matched_rule`. Use the timestamp from the latest message, set `raw_phrase` to the matched `phrase` value from `status_map.csv`, set `canonical_status` to that row's canonical value, and set `matched_rule` to that row's rule id.",
  "devices": [
    {
      "id": "linux_0",
      "type": "linux"
    },
    {
      "id": "android_0",
      "type": "android"
    }
  ],
  "setup": [
    {
      "device_id": "linux_0",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "rm -f -- /tmp/status/status_map.csv /tmp/status/normalized_status.json && mkdir -p -- /tmp/status",
            "shell": true
          }
        },
        {
          "type": "upload_file",
          "parameters": {
            "files": [
              {
                "local_path": "${repo_root}/tasks/cross_device/linux_android_assets/linux_android_1234/source/tmp/status/status_map.csv",
                "path": "/tmp/status/status_map.csv"
              }
            ]
          }
        }
      ]
    },
    {
      "device_id": "android_0",
      "config": [
        {
          "type": "ensure_app",
          "parameters": {
            "app": "simple sms messenger"
          }
        },
        {
          "type": "androidworld_sms_clear",
          "parameters": {}
        },
        {
          "type": "androidworld_sms_receive",
          "parameters": {
            "address": "5559285",
            "body": "2026-07-21T09:00:00 truck running late.",
            "wait_s": 5.0
          }
        },
        {
          "type": "androidworld_sms_receive",
          "parameters": {
            "address": "5559285",
            "body": "2026-07-21T10:45:00 truck arrived and unloading.",
            "wait_s": 5.0
          }
        },
        {
          "type": "adb_shell",
          "parameters": {
            "command": "rows=\"$(content query --uri content://sms/inbox --projection address:body --where \"address='5559285'\" --sort 'date DESC,_id DESC' 2>/dev/null)\"; test \"$(printf '%s\n' \"$rows\" | grep -c '^Row:')\" -eq 2 && latest=\"$(printf '%s\n' \"$rows\" | sed -n '1p')\" && printf '%s\n' \"$latest\" | grep -F 'address=5559285' >/dev/null && printf '%s\n' \"$latest\" | grep -F 'body=2026-07-21T10:45:00 truck arrived and unloading.' >/dev/null",
            "check_exit_status": true
          }
        },
        {
          "type": "open_app",
          "parameters": {
            "app": "simple sms messenger"
          }
        }
      ]
    }
  ],
  "cleanup": [
    {
      "device_id": "linux_0",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "rm -f -- /tmp/status/status_map.csv /tmp/status/normalized_status.json; find /tmp/status -type d -empty -delete 2>/dev/null || true",
            "shell": true
          }
        }
      ]
    },
    {
      "device_id": "android_0",
      "config": [
        {
          "type": "androidworld_sms_clear",
          "parameters": {}
        }
      ]
    }
  ],
  "evaluation": [
    {
      "device_id": "linux_0",
      "func": "check_json_exact_object",
      "result": {
        "type": "vm_file",
        "path": "/tmp/status/normalized_status.json"
      },
      "expected": {
        "type": "rule",
        "rules": {
          "object": {
            "message_timestamp": "2026-07-21T10:45:00",
            "raw_phrase": "arrived and unloading",
            "canonical_status": "onsite",
            "matched_rule": "RULE-ARRIVED"
          },
          "string_values_only": true
        }
      },
      "metadata": {
        "path": "/tmp/status/normalized_status.json"
      }
    }
  ],
  "limits": {
    "max_steps": 50
  },
