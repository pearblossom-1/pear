{
  "id": "linux_android_1320",
  "instruction": "Review the recipe on the first phone and the guest allergy contact on the second phone. Use `/tmp/meal/pantry.csv` on the first Linux machine to check which required ingredients are currently available, and `/tmp/meal/suppliers.csv` on the second Linux machine to check the offered substitute for any unavailable ingredient. Write the final decision and reason to `/tmp/meal/meal_decision.md` on the second Linux machine. If the available substitute conflicts with the guest allergy, clearly block the recipe and leave `/tmp/meal/supplier_order.csv` absent.",
  "devices": [
    {
      "id": "linux_0",
      "type": "linux"
    },
    {
      "id": "linux_1",
      "type": "linux"
    },
    {
      "id": "android_0",
      "type": "android"
    },
    {
      "id": "android_1",
      "type": "android"
    }
  ],
  "setup": [
    {
      "device_id": "linux_0",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "rm -f -- /tmp/meal/pantry.csv && mkdir -p -- /tmp/meal",
            "shell": true
          }
        },
        {
          "type": "upload_file",
          "parameters": {
            "files": [
              {
                "local_path": "${repo_root}/tasks/cross_device/linux_android_assets/linux_android_1320/source/tmp/meal/pantry.csv",
                "path": "/tmp/meal/pantry.csv"
              }
            ]
          }
        },
        {
          "type": "execute",
          "parameters": {
            "command": "test -r /tmp/meal/pantry.csv && grep -F 'rice,yes' /tmp/meal/pantry.csv >/dev/null && grep -F 'cooking oil,no' /tmp/meal/pantry.csv >/dev/null && grep -F 'cucumber,yes' /tmp/meal/pantry.csv >/dev/null",
            "shell": true
          }
        }
      ]
    },
    {
      "device_id": "linux_1",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "rm -f -- /tmp/meal/suppliers.csv /tmp/meal/meal_decision.md /tmp/meal/supplier_order.csv && mkdir -p -- /tmp/meal",
            "shell": true
          }
        },
        {
          "type": "upload_file",
          "parameters": {
            "files": [
              {
                "local_path": "${repo_root}/tasks/cross_device/linux_android_assets/linux_android_1320/source/linux_1/tmp/meal/suppliers.csv",
                "path": "/tmp/meal/suppliers.csv"
              }
            ]
          }
        },
        {
          "type": "execute",
          "parameters": {
            "command": "test -r /tmp/meal/suppliers.csv && grep -F 'cooking oil,Supplier A,sesame oil' /tmp/meal/suppliers.csv >/dev/null && grep -F 'cucumber,Supplier B,cucumber' /tmp/meal/suppliers.csv >/dev/null && test -w /tmp/meal && test ! -e /tmp/meal/meal_decision.md && test ! -e /tmp/meal/supplier_order.csv",
            "shell": true
          }
        }
      ]
    },
    {
      "device_id": "android_0",
      "config": [
        {
          "type": "ensure_app",
          "parameters": {
            "app": "broccoli app"
          }
        },
        {
          "type": "androidworld_recipes_clear",
          "parameters": {}
        },
        {
          "type": "androidworld_recipe_add",
          "parameters": {
            "title": "Harbor Rice Bowl",
            "ingredients": "rice; cooking oil; cucumber",
            "directions": "Mix and serve.",
            "preparationTime": ""
          }
        },
        {
          "type": "androidworld_broccoli_recipe_preflight",
          "parameters": {
            "recipe": {
              "title": "Harbor Rice Bowl",
              "ingredients": "rice; cooking oil; cucumber",
              "directions": "Mix and serve.",
              "preparationTime": ""
            },
            "required_visible_text": ["Harbor Rice Bowl", "cooking oil"]
          }
        },
        {
          "type": "open_app",
          "parameters": {
            "app": "broccoli app"
          }
        }
      ]
    },
    {
      "device_id": "android_1",
      "config": [
        {
          "type": "ensure_app",
          "parameters": {
            "app": "contacts"
          }
        },
        {
          "type": "androidworld_contacts_clear",
          "parameters": {}
        },
        {
          "type": "androidworld_contact_add",
          "parameters": {
            "name": "Emily Carter",
            "number": "5554817",
            "notes": "Allergy: sesame"
          }
        },
        {
          "type": "androidworld_contact_preflight",
          "parameters": {
            "contact": {
              "name": "Emily Carter",
              "number": "5554817",
              "notes_exact": "Allergy: sesame"
            },
            "required_visible_text": ["Emily Carter", "Allergy: sesame"]
          }
        },
        {
          "type": "open_app",
          "parameters": {
            "app": "contacts"
          }
        }
      ]
    }
  ],
  "cleanup": [
    {
      "device_id": "linux_0",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "rm -f -- /tmp/meal/pantry.csv; find /tmp/meal -type d -empty -delete 2>/dev/null || true",
            "shell": true
          }
        }
      ]
    },
    {
      "device_id": "linux_1",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "rm -f -- /tmp/meal/suppliers.csv /tmp/meal/meal_decision.md /tmp/meal/supplier_order.csv; find /tmp/meal -type d -empty -delete 2>/dev/null || true",
            "shell": true
          }
        }
      ]
    },
    {
      "device_id": "android_0",
      "config": [
        {
          "type": "androidworld_recipes_clear",
          "parameters": {}
        }
      ]
    },
    {
      "device_id": "android_1",
      "config": [
        {
          "type": "androidworld_contacts_clear",
          "parameters": {}
        }
      ]
    }
  ],
  "evaluation": [
    {
      "device_id": "linux_1",
      "func": "check_include_exclude",
      "result": {
        "type": "vm_command_line",
        "command": "cat /tmp/meal/meal_decision.md 2>/dev/null || echo missing",
        "shell": true
      },
      "expected": {
        "type": "rule",
        "rules": {
          "include": ["Harbor Rice Bowl", "cooking oil", "sesame oil"],
          "exclude": ["missing", "placeholder"],
          "entity_relation": {
            "entities": [
              "Harbor Rice Bowl",
              "cooking oil",
              "sesame oil",
              ["Emily Carter", "guest allergy", "guest's sesame allergy", "guest is allergic to sesame", "allergic to sesame", "allergy: sesame"]
            ],
            "required_phrases": [
              ["not on hand", "unavailable", "missing ingredient", "out of stock"],
              ["offered substitute", "available substitute", "substitute is sesame oil", "sesame oil substitute", "Supplier A offers sesame oil", "cooking oil -> sesame oil"],
              ["sesame allergy", "allergy: sesame", "allergy = sesame", "allergic to sesame", "sesame-allergic", "guest allergy: sesame"]
            ],
            "positive_phrases": [
              ["blocked", "unsafe", "cannot serve", "do not serve"]
            ],
            "conflict_phrases": ["not blocked", "is safe", "safe to serve", "approved to serve", "cooking oil is on hand", "substitute is olive oil", "olive oil substitute", "peanut allergy", "order sesame oil", "order placed", "supplier order created"],
            "allowed_negative_capability_phrases": ["not on hand", "do not serve"],
            "reject_incomplete_semantics": true
          },
          "case_sensitive": false
        }
      },
      "metadata": {
        "path": "/tmp/meal/meal_decision.md"
      }
    },
    {
      "device_id": "linux_1",
      "func": "exact_match",
      "result": {
        "type": "vm_command_line",
        "command": "test ! -e /tmp/meal/supplier_order.csv && echo missing || echo present",
        "shell": true
      },
      "expected": {
        "type": "rule",
        "rules": {
          "expected": "missing"
        }
      },
      "metadata": {
        "path": "/tmp/meal/supplier_order.csv"
      }
    }
  ],
