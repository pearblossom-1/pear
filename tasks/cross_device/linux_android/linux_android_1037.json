{
  "id": "linux_android_1037",
  "instruction": "Use `1037-A_source.md` in Downloads on the first phone together with `/tmp/sites/site_registry.csv` and `/tmp/sites/handoff_policy.md` on the Linux machine. Add the approved site to OsmAnd Favorites on the second phone while preserving the existing `Reference Depot` favorite unchanged. Then create a Markor note called `1037-A handoff` that identifies the case, owner, approval code, site, coordinates, and confirms the favorite is ready.",
  "devices": [
    {
      "id": "android_0",
      "type": "android"
    },
    {
      "id": "android_1",
      "type": "android"
    },
    {
      "id": "linux_0",
      "type": "linux"
    }
  ],
  "setup": [
    {
      "device_id": "android_0",
      "config": [
        {
          "type": "ensure_app",
          "parameters": {
            "app": "files"
          }
        },
        {
          "type": "ensure_app",
          "parameters": {
            "app": "markor"
          }
        },
        {
          "type": "upload_file",
          "parameters": {
            "files": [
              {
                "local_path": "${repo_root}/tasks/cross_device/linux_android_assets/linux_android_1037/android/1037-A_source.md",
                "path": "/sdcard/Download/1037-A_source.md"
              }
            ]
          }
        },
        {
          "type": "androidworld_files_directory_preflight",
          "parameters": {
            "directory": "/sdcard/Download",
            "expected_filenames": [
              "1037-A_source.md"
            ],
            "open_filename": "1037-A_source.md",
            "required_visible_text": [
              "Case: 1037-A",
              "Approval code: NX03781",
              "Owner: Priya Shah",
              "Status: approved"
            ]
          }
        }
      ]
    },
    {
      "device_id": "android_1",
      "config": [
        {
          "type": "ensure_app",
          "parameters": {
            "app": "osmand"
          }
        },
        {
          "type": "androidworld_osmand_favorites_setup",
          "parameters": {}
        },
        {
          "type": "adb_shell",
          "parameters": {
            "command": "am force-stop net.osmand 2>/dev/null || true; rm -f '/storage/emulated/0/Android/data/net.osmand/files/favorites/favorites.gpx' '/storage/emulated/0/Documents/Markor/1037-A handoff.md'; su 0 rm -f '/data/data/net.osmand/files/favourites_bak.gpx' 2>/dev/null || true; test ! -e '/storage/emulated/0/Android/data/net.osmand/files/favorites/favorites.gpx' && test ! -e '/storage/emulated/0/Documents/Markor/1037-A handoff.md'",
            "check_exit_status": true
          }
        },
        {
          "type": "upload_file",
          "parameters": {
            "files": [
              {
                "local_path": "${repo_root}/tasks/cross_device/linux_android_assets/linux_android_1037/android/baseline_favorites.gpx",
