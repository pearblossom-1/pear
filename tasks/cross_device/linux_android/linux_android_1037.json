              }
            ]
          }
        },
        {
          "type": "androidworld_osmand_favorites_preflight",
          "parameters": {
            "favorites": [
              {
                "name": "Reference Depot",
                "latitude": "37.7000",
                "longitude": "-122.3000"
              }
            ]
          }
        },
        {
          "type": "ensure_app",
          "parameters": {
            "app": "markor"
          }
        }
      ]
    },
    {
      "device_id": "linux_0",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "mkdir -p /tmp/sites && rm -f /tmp/sites/site_registry.csv /tmp/sites/handoff_policy.md",
            "shell": true
          }
        },
        {
          "type": "upload_file",
          "parameters": {
            "files": [
              {
                "local_path": "${repo_root}/tasks/cross_device/linux_android_assets/linux_android_1037/source/site_registry.csv",
                "path": "/tmp/sites/site_registry.csv"
              },
              {
                "local_path": "${repo_root}/tasks/cross_device/linux_android_assets/linux_android_1037/source/handoff_policy.md",
                "path": "/tmp/sites/handoff_policy.md"
              }
            ]
          }
        },
        {
          "type": "execute",
          "parameters": {
            "command": "set -e\nregistry=/tmp/sites/site_registry.csv\npolicy=/tmp/sites/handoff_policy.md\ntest -r \"$registry\"\ntest -r \"$policy\"\nhead -n 1 \"$registry\" | grep -Fx 'approval_code,status,site,latitude,longitude,route' >/dev/null\ntest \"$(awk -F, 'NR > 1 && $1 == \"NX03781\" && $2 == \"approved\" && $3 == \"North Service Gate\" && $4 == \"37.7812\" && $5 == \"-122.4018\" { count++ } END { print count + 0 }' \"$registry\")\" -eq 1\ngrep -F 'Keep all existing reference favorites unchanged.' \"$policy\" >/dev/null",
            "shell": true
          }
        }
      ]
    }
  ],
