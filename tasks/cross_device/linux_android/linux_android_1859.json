            ]
          }
        },
        {
          "type": "execute",
          "parameters": {
            "command": "set -e\ntemplate=/tmp/inspection/packet_template.odt\ntest -r \"$template\"\ntest -w /tmp/inspection\ntest ! -e /tmp/inspection/packet.odt\nunzip -t \"$template\" >/dev/null\nfor member in content.xml styles.xml meta.xml; do unzip -Z1 \"$template\" | grep -Fx \"$member\" >/dev/null; done\ncontent=\"$(unzip -p \"$template\" content.xml)\"\nfor marker in 'Field Inspection Packet' '[[CASE]]' '[[APPROVAL]]' '[[OWNER]]' '[[ROUTE]]' '[[SITE]]' '[[COORDINATES]]' '[[INSPECTION_WINDOW]]' '[[DECISION]]' '[[PHOTO_OBSERVATION]]'; do printf '%s' \"$content\" | grep -F \"$marker\" >/dev/null; done\ncommand -v libreoffice >/dev/null\nnohup libreoffice --writer --nologo --norestore --nofirststartwizard '-env:UserInstallation=file:///tmp/mdcbench-linux-android-1859-writer-profile' \"$template\" >/tmp/inspection/writer.log 2>&1 &\nsleep 4\npgrep -f 'mdcbench-linux-android-1859-writer-profile' >/dev/null",
