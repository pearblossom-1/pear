    {
      "device_id": "linux_0",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "mkdir -p /tmp/agenda /tmp/attendees && rm -f /tmp/agenda/agenda_template.odt /tmp/attendees/attendee_matrix.csv",
            "shell": true
          }
        },
        {
          "type": "upload_file",
          "parameters": {
            "files": [
              {
                "local_path": "${repo_root}/tasks/cross_device/linux_android_assets/linux_android_1866/source/attendee_matrix.csv",
                "path": "/tmp/attendees/attendee_matrix.csv"
              }
            ]
          }
        },
        {
          "type": "execute",
          "parameters": {
            "command": "set -e\nfile=/tmp/attendees/attendee_matrix.csv\ntest -r \"$file\"\nhead -n 1 \"$file\" | grep -Fx 'case,status,code,owner,phone,email,route,site,time,filename,include,notes' >/dev/null\ntest \"$(awk -F, 'NR > 1 && $1 == \"CASE-1866\" && $2 == \"ready\" && $3 == \"FB-1866\" && $11 == \"yes\" { count++ } END { print count + 0 }' \"$file\")\" -eq 1\ntest ! -e /tmp/agenda/agenda_template.odt",
            "shell": true
          }
        }
      ]
    },
    {
      "device_id": "linux_1",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "pkill -f 'mdcbench-linux-android-1866-writer-profile' 2>/dev/null || true\nrm -rf /tmp/mdcbench-linux-android-1866-writer-profile\nmkdir -p /tmp/agenda /tmp/attendees\nrm -f /tmp/agenda/agenda_template.odt /tmp/attendees/packet.odt /tmp/agenda/writer.log",
            "shell": true
          }
        },
