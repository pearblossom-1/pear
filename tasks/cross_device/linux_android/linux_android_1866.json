            ]
          }
        },
        {
          "type": "execute",
          "parameters": {
            "command": "set -e\ntemplate=/tmp/agenda/agenda_template.odt\ntest -r \"$template\"\ntest -w /tmp/attendees\ntest ! -e /tmp/attendees/packet.odt\nunzip -t \"$template\" >/dev/null\ncontent=\"$(unzip -p \"$template\" content.xml)\"\nfor marker in 'Calendar Attendee Packet' '[[CASE]]' '[[APPROVAL]]' '[[NAME]]' '[[PHONE]]' '[[EMAIL]]' '[[ROLE]]' '[[TIME]]' '[[LOCATION]]' '[[ROUTE]]' '[[STATUS]]' 'Notes: complete from Calendar, Contacts, and attendee matrix' 'Review: confirm all sections before handoff' 'Handoff: second Linux desktop'; do printf '%s' \"$content\" | grep -F \"$marker\" >/dev/null; done\ncommand -v libreoffice >/dev/null\nnohup libreoffice --writer --nologo --norestore --nofirststartwizard '-env:UserInstallation=file:///tmp/mdcbench-linux-android-1866-writer-profile' \"$template\" >/tmp/agenda/writer.log 2>&1 &\nsleep 4\npgrep -f 'mdcbench-linux-android-1866-writer-profile' >/dev/null",
            "shell": true
          }
        }
      ]
