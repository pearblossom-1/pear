          "type": "adb_shell",
          "parameters": {
            "command": "rows=\"$(content query --uri content://com.android.contacts/data --projection display_name:mimetype:data1 2>/dev/null)\"; printf '%s\\n' \"$rows\" | grep -F 'display_name=Nora Alvarez' | grep -F 'data1=+15552001830' >/dev/null && printf '%s\\n' \"$rows\" | grep -F 'display_name=Nora Alvarez' | grep -F 'nora.alvarez@example.test' | grep -F 'Release coordinator' >/dev/null",
