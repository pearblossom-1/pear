            "command": "rm -f -- /tmp/release/manifest.csv /tmp/release/ready_release.zip /tmp/release/files/dispatch_client.py /tmp/release/files/release_notes.md /tmp/release/files/release_notes_draft.md /tmp/release/files/legacy_config.json; rmdir /tmp/release/files /tmp/release 2>/dev/null || true",
