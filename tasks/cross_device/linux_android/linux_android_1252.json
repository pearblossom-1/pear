      ]
    },
    {
      "device_id": "linux_1",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "rm -f -- /tmp/evidence/missing_report.csv /tmp/evidence/evidence_package.zip && mkdir -p -- /tmp/evidence",
            "shell": true
          }
        }
      ]
    },
    {
      "device_id": "android_0",
