{
  "id": "linux_android_1252",
  "instruction": "Compare `/tmp/evidence/required_manifest.csv` on the first Linux desktop with the phone's Download/evidence folder. If a required file is missing, use the second Linux desktop for the result: do not create `/tmp/evidence/evidence_package.zip` there, and write `/tmp/evidence/missing_report.csv` there with columns `package_id`, `missing_filename`, and `decision`, one row per missing required file.",
  "devices": [
