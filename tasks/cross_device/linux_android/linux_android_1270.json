      "id": "android_0",
      "type": "android"
    }
  ],
  "setup": [
    {
      "device_id": "linux_0",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "rm -f -- /tmp/pantry/pantry_plan.csv && mkdir -p -- /tmp/pantry",
            "shell": true
          }
        },
        {
          "type": "upload_file",
          "parameters": {
            "files": [
