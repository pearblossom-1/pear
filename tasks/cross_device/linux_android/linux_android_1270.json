                "local_path": "${repo_root}/tasks/cross_device/linux_android_assets/linux_android_1270/source/tmp/pantry/pantry_plan.csv",
                "path": "/tmp/pantry/pantry_plan.csv"
              }
            ]
          }
        },
        {
          "type": "execute",
          "parameters": {
            "command": "test -r /tmp/pantry/pantry_plan.csv",
            "shell": true
          }
        }
      ]
    },
    {
      "device_id": "linux_1",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "rm -f -- /tmp/pantry/recipe_check.xlsx && mkdir -p -- /tmp/pantry",
            "shell": true
          }
        },
        {
          "type": "execute",
          "parameters": {
            "command": "test ! -e /tmp/pantry/recipe_check.xlsx && test -w /tmp/pantry",
            "shell": true
          }
        }
      ]
    },
    {
      "device_id": "android_0",
