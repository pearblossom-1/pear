{
  "id": "linux_android_1241",
  "instruction": "Please set up the planning meeting and notify its active attendees. The meeting details are in `/tmp/meeting/brief.odt` on the first Linux machine, and `/tmp/meeting/attendees.csv` on the second identifies active and archived attendees. Create the event in Simple Calendar Pro using the title, start time, end time, and location from the brief. Text each active attendee the meeting title, start time, and location, and do not text the archived attendee. Use `/tmp/meeting/brief_transform_audit_template.csv` on the first Linux machine to create `/tmp/meeting/brief_transform_audit.csv`, with one row for each attendee. Use the active meeting title for every audit row, and mark active attendees as `notified` and the archived attendee as `skipped`.",
  "devices": [
    {
      "id": "linux_0",
      "type": "linux"
    },
    {
      "id": "linux_1",
      "type": "linux"
    },
    {
      "id": "android_0",
      "type": "android"
    }
  ],
  "setup": [
    {
      "device_id": "linux_0",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "rm -f -- /tmp/meeting/brief.odt /tmp/meeting/brief_transform_audit.csv /tmp/meeting/brief_transform_audit_template.csv && mkdir -p -- /tmp/meeting",
            "shell": true
          }
        },
        {
          "type": "upload_file",
          "parameters": {
            "files": [
              {
                "local_path": "${repo_root}/tasks/cross_device/linux_android_assets/linux_android_1241/source/tmp/meeting/brief.odt",
                "path": "/tmp/meeting/brief.odt"
              },
              {
                "local_path": "${repo_root}/tasks/cross_device/linux_android_assets/linux_android_1241/source/tmp/meeting/brief_transform_audit_template.csv",
                "path": "/tmp/meeting/brief_transform_audit_template.csv"
              }
            ]
          }
        },
        {
          "type": "execute",
          "parameters": {
            "command": "test -r /tmp/meeting/brief.odt && unzip -t /tmp/meeting/brief.odt >/dev/null && unzip -p /tmp/meeting/brief.odt content.xml | grep -F 'Meeting title: Ops Planning Sync' >/dev/null && unzip -p /tmp/meeting/brief.odt content.xml | grep -F 'Start: 2026-07-28 08:30' >/dev/null && unzip -p /tmp/meeting/brief.odt content.xml | grep -F 'End: 2026-07-28 09:00' >/dev/null && unzip -p /tmp/meeting/brief.odt content.xml | grep -F 'Location: Pier 3 Room B' >/dev/null && test -r /tmp/meeting/brief_transform_audit_template.csv && test \"$(cat /tmp/meeting/brief_transform_audit_template.csv)\" = 'brief_code,calendar_title,attendee_phone,decision' && test -w /tmp/meeting && test ! -e /tmp/meeting/brief_transform_audit.csv && command -v libreoffice >/dev/null",
            "shell": true
          }
        }
      ]
    },
    {
      "device_id": "linux_1",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "rm -f -- /tmp/meeting/attendees.csv && mkdir -p -- /tmp/meeting",
            "shell": true
          }
        },
        {
          "type": "upload_file",
          "parameters": {
            "files": [
              {
                "local_path": "${repo_root}/tasks/cross_device/linux_android_assets/linux_android_1241/source/linux_1/tmp/meeting/attendees.csv",
                "path": "/tmp/meeting/attendees.csv"
              }
            ]
          }
        },
        {
          "type": "execute",
          "parameters": {
            "command": "test -r /tmp/meeting/attendees.csv && test \"$(wc -l < /tmp/meeting/attendees.csv)\" -eq 4 && grep -F 'Mina,5557304,lead,attend' /tmp/meeting/attendees.csv >/dev/null && grep -F 'Noor,5558619,site,attend' /tmp/meeting/attendees.csv >/dev/null && grep -F 'Omar,5554927,archive,archived' /tmp/meeting/attendees.csv >/dev/null",
            "shell": true
          }
        }
      ]
    },
    {
      "device_id": "android_0",
      "config": [
        {
          "type": "ensure_app",
          "parameters": {
            "app": "simple calendar pro"
          }
        },
