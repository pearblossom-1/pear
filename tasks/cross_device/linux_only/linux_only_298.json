{
  "id": "linux_only_298",
  "instruction": "Prepare a playback handoff on the second Linux machine. Use the active session from `/tmp/media/current_session.csv` on the first Linux machine and confirm that its referenced clip exists in `/tmp/media/clips/` on the second Linux machine. Then write `/tmp/media/playback_review.md` on the second Linux machine with the active session ID, clip filename, and assigned reviewer.",
  "devices": [
    {
      "id": "linux_0",
      "type": "linux"
    },
    {
      "id": "linux_1",
      "type": "linux"
    }
  ],
  "variables": {},
  "setup": [
    {
      "device_id": "linux_0",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "mkdir -p /tmp/media && rm -f /tmp/media/current_session.csv",
            "shell": true
          }
        },
        {
          "type": "upload_file",
          "parameters": {
            "files": [
              {
                "local_path": "${repo_root}/tasks/cross_device/linux_only_assets/linux_only_298/source/linux_0/tmp/media/current_session.csv",
                "path": "/tmp/media/current_session.csv"
              }
            ]
          }
        }
      ]
    },
    {
      "device_id": "linux_1",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "python3 - <<'PY'\nimport math, struct, wave\nfrom pathlib import Path\nroot = Path('/tmp/media/clips')\nroot.mkdir(parents=True, exist_ok=True)\nfor name, frequency in [('long_audio_A.wav', 440), ('old_session.wav', 660)]:\n    path = root / name\n    path.unlink(missing_ok=True)\n    with wave.open(str(path), 'wb') as out:\n        out.setnchannels(1); out.setsampwidth(2); out.setframerate(16000)\n        frames = [struct.pack('<h', int(9000 * math.sin(2 * math.pi * frequency * i / 16000))) for i in range(16000)]\n        out.writeframes(b''.join(frames))\nPY",
            "shell": true
          }
        },
        {
          "type": "execute",
          "parameters": {
            "command": "rm -f /tmp/media/playback_review.md",
            "shell": true
          }
        }
      ]
    }
  ],
