{
  "linux_actions": [
    {
      "device_id": "linux_1",
      "type": "cli.execute",
      "parameters": {
        "command": "mkdir -p /tmp/bedroom-comfort-fallback/result && printf %s  | base64 -d > /tmp/bedroom-comfort-fallback/result/comfort_order_done.xlsx"
      }
    }
  ],
  "android_setup": {
    "android_0": [
      {
        "type": "androidworld_task_update",
        "parameters": {
          "match_title": "Bedroom comfort fallback",
          "match_notes": "Update after the SmartHome fallback is applied.",
          "updates": {
            "notes": "Bedroom fallback applied: AC cool 25 C and dehumidifier medium.",
            "completed": 1
          }
        }
      }
    ]
  },
  "smarthome_actions": [
    {
      "device_id": "home_0",
      "type": "smarthome.command",
      "parameters": {
        "device_id": "bedroom_air_conditioner_1",
        "command": "set_target_temperature",
        "args": {
          "temperature_c": 25.0
        }
      }
    },
    {
      "device_id": "home_0",
      "type": "smarthome.command",
      "parameters": {
        "device_id": "bedroom_air_conditioner_1",
        "command": "set_mode",
        "args": {
          "mode": "cool"
        }
      }
    },
    {
      "device_id": "home_0",
      "type": "smarthome.command",
      "parameters": {
        "device_id": "bedroom_air_conditioner_1",
        "command": "turn_on",
        "args": {}
      }
    },
    {
      "device_id": "home_0",
      "type": "smarthome.command",
      "parameters": {
        "device_id": "bedroom_dehumidifier_1",
        "command": "set_level",
        "args": {
          "level": "medium"
        }
      }
    },
    {
      "device_id": "home_0",
      "type": "smarthome.command",
      "parameters": {
        "device_id": "bedroom_dehumidifier_1",
        "command": "turn_on",
        "args": {}
      }
    },
    {
      "type": "done"
    }
  ]
}
