{
  "linux_actions": [
    {
      "device_id": "linux_1",
      "type": "cli.execute",
      "parameters": {
        "command": "mkdir -p /tmp/kitchen-air-incident/result && printf %s  | base64 -d > /tmp/kitchen-air-incident/result/work_register_done.xlsx"
      }
    }
  ],
  "android_setup": {
    "android_0": [
      {
        "type": "androidworld_sms_send",
        "parameters": {
          "address": "+155500877",
          "body": "Kitchen purifier high was applied and recorded for the kitchen incident."
        }
      }
    ]
  },
  "smarthome_actions": [
    {
      "device_id": "home_0",
      "type": "smarthome.command",
      "parameters": {
        "device_id": "kitchen_air_purifier_1",
        "command": "set_level",
        "args": {
          "level": "high"
        }
      }
    },
    {
      "device_id": "home_0",
      "type": "smarthome.command",
      "parameters": {
        "device_id": "kitchen_air_purifier_1",
        "command": "turn_on",
        "args": {}
      }
    },
    {
      "type": "done"
    }
  ]
}
