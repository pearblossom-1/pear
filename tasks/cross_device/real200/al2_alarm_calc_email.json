{
  "id": "al2_alarm_calc_email",
  "instruction": "The Android Clock app has a `Delivery` alarm. Open `/tmp/delivery/schedule.xlsx` in LibreOffice Calc on the first Linux machine, find the Delivery row, and fill in the alarm time. Then create a notification draft in Thunderbird on the second Linux machine using the notification recipient shown in that Delivery row. The draft should identify `Delivery` and state its alarm time.",
  "devices": [
    {
      "id": "android_0",
      "type": "android"
    },
    {
      "id": "linux_0",
      "type": "linux"
    },
    {
      "id": "linux_1",
      "type": "linux"
    }
  ],
  "setup": [
    {
      "device_id": "android_0",
      "config": [
        {
          "type": "ensure_app",
          "parameters": {
            "app": "clock"
          }
        },
        {
          "type": "androidworld_clock_clear",
          "parameters": {}
        },
        {
          "type": "androidworld_alarm_add",
          "parameters": {
            "hour": 8,
            "minute": 45,
            "label": "Delivery"
          }
        }
      ]
    },
    {
      "device_id": "linux_0",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "mkdir -p /tmp/delivery",
            "shell": true
          }
        },
        {
          "type": "upload_file",
          "parameters": {
            "files": [
              {
                "local_path": "${repo_root}/tasks/cross_device/real200_assets/al2_alarm_calc_email/source/visible/deb4d71f_schedule.xlsx",
                "path": "/tmp/delivery/schedule.xlsx"
              }
            ]
          }
        },
        {
          "type": "execute",
          "parameters": {
            "command": "rm -f /tmp/delivery/.~lock.schedule.xlsx#",
            "shell": true
          }
        },
        {
          "type": "execute",
          "parameters": {
            "command": "python3 -c \"import zipfile,xml.etree.ElementTree as E;p='/tmp/delivery/schedule.xlsx';z=zipfile.ZipFile(p);assert z.testzip() is None;r=E.fromstring(z.read('xl/worksheets/sheet1.xml'));ns={'m':'http://schemas.openxmlformats.org/spreadsheetml/2006/main'};cells={c.attrib['r']:''.join(c.itertext()) for c in r.findall('.//m:c',ns)};assert cells.get('A2')=='Delivery';assert 'delivery-team@example.test' in cells.get('H2','');assert 'C2' not in cells\"",
            "shell": true
          }
        }
      ]
    },
    {
      "device_id": "linux_1",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "set -e\nrm -rf \"$HOME/.thunderbird/mail.default-release\"\nprofile=\"$HOME/.thunderbird/mail.default-release\"\nmkdir -p \"$profile/Mail/Local Folders\"\ncat > \"$HOME/.thunderbird/profiles.ini\" <<'EOF'\n[Profile0]\nName=local\nIsRelative=1\nPath=mail.default-release\nDefault=1\n\n[General]\nStartWithLastProfile=1\nVersion=2\nEOF\ncat > \"$profile/prefs.js\" <<'EOF'\nuser_pref(\"mail.account.account1.identities\", \"id1\");\nuser_pref(\"mail.account.account1.server\", \"server1\");\nuser_pref(\"mail.accountmanager.accounts\", \"account1\");\nuser_pref(\"mail.accountmanager.defaultaccount\", \"account1\");\nuser_pref(\"mail.identity.id1.email\", \"agent@example.test\");\nuser_pref(\"mail.identity.id1.fullName\", \"Field Operator\");\nuser_pref(\"mail.server.server1.directory\", \"[ProfD]Mail/Local Folders\");\nuser_pref(\"mail.server.server1.hostname\", \"Local Folders\");\nuser_pref(\"mail.server.server1.name\", \"Local Folders\");\nuser_pref(\"mail.server.server1.type\", \"none\");\nEOF\n: > \"$profile/Mail/Local Folders/Drafts\"\n: > \"$profile/Mail/Local Folders/Drafts.msf\"\n",
            "shell": true
          }
        },
        {
          "type": "execute",
          "parameters": {
            "command": "profile=\"$HOME/.thunderbird/mail.default-release\"; command -v thunderbird >/dev/null && test -f \"$profile/prefs.js\" && test ! -s \"$profile/Mail/Local Folders/Drafts\"",
            "shell": true
          }
        }
      ]
    }
  ],
  "cleanup": [
    {
      "device_id": "android_0",
      "config": [
        {
          "type": "androidworld_clock_clear",
          "parameters": {}
        }
      ]
    },
    {
      "device_id": "linux_0",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "rm -f /tmp/delivery/schedule.xlsx /tmp/delivery/.~lock.schedule.xlsx#; rmdir /tmp/delivery 2>/dev/null || true",
            "shell": true
          }
        }
      ]
    },
    {
      "device_id": "linux_1",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "rm -rf \"$HOME/.thunderbird/mail.default-release\" \"$HOME/.thunderbird/profiles.ini\"",
            "shell": true
          }
        }
      ]
    }
  ],
  "evaluation": [
    {
      "device_id": "linux_0",
      "func": "check_xlsx_cells",
      "result": {
        "type": "vm_file",
        "path": "/tmp/delivery/schedule.xlsx"
      },
      "expected": {
        "type": "rule",
        "rules": {
          "sheet": "Schedule",
          "preserve_from": "${repo_root}/tasks/cross_device/real200_assets/al2_alarm_calc_email/source/visible/deb4d71f_schedule.xlsx",
          "allowed_changes": [
            "Schedule!C2"
          ],
          "cells": {
            "A1": "item",
            "A2": "Delivery",
            "C2": "08:45"
          },
          "forbidden": [
            {
              "cell": "C2",
              "value": ""
            }
          ]
        }
      }
    },
    {
      "device_id": "linux_1",
      "func": "exact_match",
      "result": {
        "type": "thunderbird_draft_state",
        "profile_root": "~/.thunderbird/mail.default-release",
        "recipients": [
          "delivery-team@example.test"
        ],
        "allow_extra_recipients": false,
        "recipient_header_policy": "single_to_only",
        "attachments": [],
        "allow_extra_attachments": false,
        "mime_body_policy": "safe_visible_text",
        "message_relation": {
          "entities": [
            "Delivery",
            [
              "08:45",
              "8:45",
              "08:45 AM",
              "8:45 AM",
              "8:45AM"
            ]
          ],
          "nearest_relations": [
            {
              "anchor": [
                "Delivery"
              ],
              "expected": [
                "08:45",
                "8:45"
              ],
              "forbidden": [
                "09:15",
                "9:15"
              ],
              "max_distance": 32,
              "same_clause": false
            }
          ],
          "conflict_patterns": [
            "\\bDelivery\\b\\s*(?:(?:alarm|notification(?:\\s+time)?|time)\\s*)?(?:(?:is|was|=|:|[-\\u2014])\\s*)?(?:(?:at|set\\s+for|scheduled\\s+for)\\s*)?(?!(?:0?8:45)(?:\\s*a\\.?m\\.?)?\\b)(?:[01]?\\d|2[0-3]):[0-5]\\d(?:\\s*[ap]\\.?m\\.?)?\\b"
          ],
          "reject_incomplete_semantics": true
        },
        "reject_negative_or_uncertain_claims": true
      },
      "expected": {
        "type": "rule",
        "rules": {
          "expected": "present"
        }
      }
    },
    {
      "device_id": "linux_1",
      "func": "exact_match",
      "enable_score_calc": false,
      "result": {
        "type": "thunderbird_folder_state",
        "profile_root": "~/.thunderbird/mail.default-release",
        "inbox_messages": [],
        "folder_messages": {
          "Sent": []
        }
      },
      "expected": {
        "type": "rule",
        "rules": {
          "expected": "exact"
        }
      }
    }
  ],
  "limits": {
    "max_steps": 70,
    "max_wall_time_s": 540
  },
  "metadata": {
    "category": "real200_cross_device",
    "source_card": "184",
    "difficulty": "Medium",
    "motif": "M5",
    "interaction_mode": "GUI-focused",
    "device_topology": "1A+2L",
    "surfaces": "Android Clock app + linux_0 Calc + linux_1 Thunderbird",
    "setup_note": "Android provides the Delivery alarm; linux_0 provides schedule.xlsx with the notification recipient cue in the Delivery row; linux_1 provides a clean Thunderbird profile for the draft.",
    "evaluate_note": "Checks the source-preserving Calc update and requires at least one matching task-profile draft whose Delivery label and 08:45 time form a local positive relation. Unrelated drafts and unrelated times do not affect scoring.",
    "implementation_status": "fixture_scaffold",
    "readiness": "R1_native_content_thunderbird_state",
    "native_evaluator_status": "native_content_thunderbird_state",
    "requires_helper_audit": false,
    "asset_source": "tasks/cross_device/real200_assets/al2_alarm_calc_email/source",
