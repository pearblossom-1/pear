        "func": "check_xlsx_cells",
        "expected_file": null,
        "device_id": "linux_0",
        "rules": {
          "sheet": "Schedule",
          "cells": {
            "A1": "item",
            "A2": "Delivery",
            "C2": "08:45"
          },
          "forbidden": [
            {
              "cell": "C2",
              "value": ""
            }
          ]
        }
      }
    ],
    "android_state_outputs": [],
    "android_file_outputs": [],
    "android_text_outputs": [],
    "browser_state_outputs": [],
    "thunderbird_draft_outputs": [
      {
        "device_id": "linux_1",
        "include": [
          "delivery-team@example.test",
          "Delivery",
          "08:45"
        ],
        "exclude": [
