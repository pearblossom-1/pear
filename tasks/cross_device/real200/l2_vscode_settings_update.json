      },
      {
        "path": "/tmp/code/project/.vscode/settings.json",
        "source_file": "source/project/.vscode/settings.json"
      }
    ],
    "instruction_visible_outputs": [],
    "native_file_presence_outputs": [],
    "native_content_outputs": [
      {
        "device_id": "linux_1",
        "path": "/tmp/code/project/.vscode/settings.json",
        "func": "check_json",
        "expected_file": null,
        "rules": {
          "expect": [
            {
              "key": [
                "python.testing.pytestEnabled"
              ],
              "method": "eq",
              "ref": true
            },
            {
              "key": [
                "editor.formatOnSave"
              ],
              "method": "eq",
              "ref": true
            },
            {
              "key": [
                "files.exclude",
                "**/__pycache__"
              ],
              "method": "eq",
              "ref": true
            }
          ],
          "unexpect": [
            {
              "key": [
                "python.testing.pytestEnabled"
              ],
              "method": "eq",
              "ref": false
            },
            {
              "key": [
                "editor.formatOnSave"
              ],
