{
  "android_setup": {
    "android_1": [
      {
        "type": "adb_shell",
        "parameters": {
          "command": "mkdir -p /sdcard/Download/Keep && cat > /sdcard/Download/Keep/agenda.txt <<'EOF'\nTeam agenda draft.\nEOF"
        }
      },
      {
        "type": "adb_shell",
        "parameters": {
          "command": "mkdir -p /sdcard/Download/Review && cat > /sdcard/Download/Review/parking.txt <<'EOF'\nParking information.\nEOF"
        }
      },
      {
        "type": "adb_shell",
        "parameters": {
          "command": "mkdir -p /sdcard/Download/incoming && cat > /sdcard/Download/incoming/supplies.txt <<'EOF'\nSupply notes.\nEOF"
        }
      },
      {
        "type": "adb_shell",
        "parameters": {
          "command": "rm -f /sdcard/Download/incoming/agenda.txt"
        }
      },
      {
        "type": "adb_shell",
        "parameters": {
          "command": "rm -f /sdcard/Download/incoming/parking.txt"
        }
      },
      {
        "type": "adb_shell",
        "parameters": {
          "command": "rm -f /sdcard/Download/Review/visitors.txt"
        }
      },
      {
        "type": "adb_shell",
        "parameters": {
          "command": "mkdir -p '/storage/emulated/0/Documents/Markor' && cat > '/storage/emulated/0/Documents/Markor/Sort summary.md' <<'EOF'\nagenda.txt: moved to Keep\nparking.txt: moved to Review\nsupplies.txt: left in incoming\nvisitors.txt: missing\nEOF"
        }
      }
    ]
  }
}
