{
  "id": "linux_android_smarthome_025",
  "instruction": "After the `Dinner Guests` event ends, return the living room to the baseline described in `/tmp/guest/restore.docx`. Schedule the restore workflow for the required time, and leave a `Dinner Restore.md` note in Markor with that time and the final light, curtain, purifier, and heater settings.",
  "devices": [
    {
      "id": "linux_0",
      "type": "linux"
    },
    {
      "id": "android_0",
      "type": "android"
    },
    {
      "id": "home_0",
      "type": "home"
    }
  ],
  "setup": [
    {
      "device_id": "linux_0",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "mkdir -p /tmp/guest",
            "shell": true
          }
        },
        {
          "type": "upload_file",
          "parameters": {
            "files": [
              {
                "local_path": "${repo_root}/tasks/cross_device/linux_android_smarthome_assets/linux_android_smarthome_025/source/tmp/guest/restore.docx",
                "path": "/tmp/guest/restore.docx"
              }
            ]
          }
        }
      ]
    },
    {
      "device_id": "android_0",
      "config": [
        {
          "type": "ensure_app",
          "parameters": {
            "app": "simple calendar pro"
          }
        },
        {
          "type": "androidworld_calendar_clear",
          "parameters": {}
        },
        {
          "type": "androidworld_calendar_event_add",
          "parameters": {
            "title": "Dinner Guests",
            "start_ts": 1781634600,
            "end_ts": 1781643600,
            "location": "Living room",
            "description": "Restore room after guests leave."
          }
        },
        {
          "type": "ensure_app",
          "parameters": {
            "app": "markor"
          }
        },
        {
          "type": "adb_shell",
          "parameters": {
            "command": "rm -f '/storage/emulated/0/Documents/Markor/Dinner Restore.md'"
          }
        }
      ]
    },
    {
      "device_id": "home_0",
      "config": [
        {
          "type": "smarthome.reset",
          "parameters": {
            "episode_config_ref": "tasks/cross_device/linux_android_smarthome_assets/linux_android_smarthome_025/episode_config.json"
          }
        }
      ]
    }
  ],
  "cleanup": [
    {
      "device_id": "linux_0",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "rm -f /tmp/guest/restore.docx; rmdir /tmp/guest 2>/dev/null || true",
            "shell": true
          }
        }
      ]
    },
    {
      "device_id": "android_0",
      "config": [
        {
          "type": "androidworld_calendar_clear",
          "parameters": {}
        },
        {
          "type": "adb_shell",
          "parameters": {
            "command": "rm -f '/storage/emulated/0/Documents/Markor/Dinner Restore.md'"
          }
        }
      ]
    },
    {
      "device_id": "home_0",
      "config": [
        {
          "type": "smarthome.reset",
          "parameters": {}
        }
      ]
    }
  ],
  "evaluation": [
    {
      "device_id": "android_0",
      "func": "exact_match",
      "result": {
        "type": "android_entity_relation_note",
        "path": "/storage/emulated/0/Documents/Markor/Dinner Restore.md",
        "rules": {
          "entities": [
            "Dinner restore",
            [
              "21:10",
              "9:10 PM"
            ],
            [
              "light 20%",
              "light 20 percent"
            ],
            [
              "curtain closed",
              "close curtain"
            ],
            [
              "purifier off",
              "air purifier off"
            ],
            [
              "heater 20 C",
              "heater 20 degrees"
            ]
          ],
          "reject_questions": true,
          "reject_uncertainty": true,
          "reject_negated_relations": true
        }
      },
      "expected": {
        "type": "rule",
        "rules": {
          "expected": "pass"
        }
      }
    },
    {
      "device_id": "home_0",
      "func": "smarthome.check_workflow_effects",
      "result": {
        "type": "smarthome_workflows"
      },
      "expected": {
        "type": "rule",
        "rules": {
          "expected": {
            "run_at": "2026-06-16T21:10:00",
            "status": "active",
            "effects": {
              "living_room_dimmable_light_1": {
                "power": "on",
                "brightness_pct": 20
              },
              "living_room_curtain_1": {
                "open_pct": 0
              },
              "living_room_air_purifier_1": {
                "power": "off"
              },
              "living_room_heater_1": {
                "target_temperature_c": 20.0
              }
            }
          }
        }
      }
    }
  ],
  "limits": {
    "max_steps": 50
  },
  "metadata": {
    "category": "linux_android_smarthome",
    "source_idea": "Pilot 25 guest restore workflow.",
    "surfaces": [
      "calendar",
      "home_workflow",
      "linux_docx",
      "markor"
    ],
    "capability_tags": [
      "android_app_interaction",
      "information_transfer",
      "linux_interaction",
      "smarthome_reasoning",
      "temporal_or_workflow_planning"
    ],
    "asset_dir": "tasks/cross_device/linux_android_smarthome_assets/linux_android_smarthome_025",
    "episode_config_ref": "tasks/cross_device/linux_android_smarthome_assets/linux_android_smarthome_025/episode_config.json",
    "oracle_ref": "tasks/cross_device/linux_android_smarthome_assets/linux_android_smarthome_025/oracle_positive.json",
    "linux_source_paths": [
      "/tmp/guest/restore.docx"
    ],
    "linux_output_paths": [],
    "linux_source_paths_by_device": {
      "linux_0": [
        "/tmp/guest/restore.docx"
      ]
    },
    "linux_output_paths_by_device": {},
    "pilot_index": 25,
    "lite_evaluator_hardening_note": "Markor evaluator searches user-created notes by required content rather than requiring a hidden filename."
  }
}
