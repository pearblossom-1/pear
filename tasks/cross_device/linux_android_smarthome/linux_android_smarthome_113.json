        "rules": {
          "include": [
            "Visitor record"
          ],
          "exclude": [
            "placeholder"
          ],
          "require_valid_package": true,
          "case_sensitive": false,
          "template_structure": {
            "body_paragraphs": [
              "Visitor record"
            ],
            "exact_tables": 1
