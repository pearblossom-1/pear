            "notes": "Role: Owner for guest-room routine decisions."
          }
        },
        {
          "type": "ensure_app",
          "parameters": {
            "app": "markor"
          }
        },
        {
          "type": "adb_shell",
          "parameters": {
            "command": "rm -f '/storage/emulated/0/Documents/Markor/Guest room decision 288.md'"
          }
        }
      ]
    },
    {
      "device_id": "home_0",
      "config": [
        {
          "type": "smarthome.reset",
          "parameters": {
            "episode_config_ref": "tasks/cross_device/linux_android_smarthome_assets/linux_android_smarthome_288/episode_config.json"
          }
        }
      ]
    }
  ],
