{
  "id": "linux_android_smarthome_792",
  "instruction": "Use the Hallway daylight preference note on Android, the 120-lux SmartHome reading, and `/tmp/home_ops/room-updates/source/curtain.csv` to choose and apply the curtain setting. Record the reading, preference, and setting you applied in Markor as `Hallway daylight decision.md`.",
  "devices": [
    {
      "id": "linux_0",
      "type": "linux"
    },
    {
      "id": "android_0",
      "type": "android"
    },
    {
      "id": "home_0",
      "type": "home"
    }
  ],
  "setup": [
    {
      "device_id": "linux_0",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "mkdir -p /tmp/home_ops/room-updates/source",
            "shell": true
          }
        },
        {
          "type": "upload_file",
          "parameters": {
            "files": [
              {
