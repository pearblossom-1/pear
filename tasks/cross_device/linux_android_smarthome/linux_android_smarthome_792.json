              }
            ]
          }
        }
      ]
    },
    {
      "device_id": "android_0",
      "config": [
        {
          "type": "ensure_app",
          "parameters": {
            "app": "markor"
          }
        },
        {
          "type": "upload_file",
          "parameters": {
            "files": [
              {
                "local_path": "${repo_root}/tasks/cross_device/linux_android_smarthome_assets/linux_android_smarthome_792/android/android_0/Hallway daylight.md",
                "path": "/storage/emulated/0/Documents/Markor/Hallway daylight.md"
              }
            ]
          }
        },
        {
          "type": "adb_shell",
          "parameters": {
            "command": "rm -f '/storage/emulated/0/Documents/Markor/Hallway daylight decision.md'"
          }
        }
      ]
    },
    {
      "device_id": "home_0",
      "config": [
        {
          "type": "smarthome.reset",
          "parameters": {
            "episode_config_ref": "tasks/cross_device/linux_android_smarthome_assets/linux_android_smarthome_792/episode_config.json"
          }
        }
      ]
    }
  ],
  "cleanup": [
    {
      "device_id": "linux_0",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "rm -f /tmp/home_ops/room-updates/source/curtain.csv; rmdir /tmp/home_ops/room-updates/source 2>/dev/null || true",
            "shell": true
          }
        }
      ]
    },
    {
      "device_id": "android_0",
      "config": [
        {
          "type": "adb_shell",
          "parameters": {
            "command": "rm -f '/storage/emulated/0/Documents/Markor/Hallway daylight decision.md' '/storage/emulated/0/Documents/Markor/Hallway daylight.md'"
          }
        }
      ]
    },
    {
      "device_id": "home_0",
      "config": [
        {
          "type": "smarthome.reset",
          "parameters": {}
        }
      ]
    }
  ],
  "evaluation": [
    {
      "device_id": "android_0",
      "func": "exact_match",
      "result": {
        "type": "android_entity_relation_note",
        "path": "/storage/emulated/0/Documents/Markor/Hallway daylight decision.md",
        "rules": {
          "entities": [
            "Hallway",
            [
              "120 lux",
              "120-lux"
            ],
            [
              "moderate daylight",
              "moderate-daylight"
            ],
            [
              "65 percent",
              "65%"
            ],
            [
              "curtain",
              "curtains"
            ]
          ],
          "reject_questions": true,
          "reject_uncertainty": true,
          "reject_negated_relations": true
        }
      },
      "expected": {
        "type": "rule",
        "rules": {
          "expected": "pass"
        }
      }
    },
    {
      "device_id": "home_0",
      "func": "smarthome.check_device_state",
      "result": {
        "type": "smarthome_device_state",
        "device_id": "hallway_curtain_1"
      },
      "expected": {
        "type": "rule",
        "rules": {
          "expected": {
            "open_pct": 65
          }
        }
      }
    }
  ],
  "limits": {
    "max_steps": 50
  },
