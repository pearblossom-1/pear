      "device_id": "linux_0",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "mkdir -p /tmp/quiet-hours",
            "shell": true
          }
        },
        {
          "type": "upload_file",
          "parameters": {
            "files": [
