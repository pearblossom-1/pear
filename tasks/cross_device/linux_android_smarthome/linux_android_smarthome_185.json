{
  "id": "linux_android_smarthome_185",
  "instruction": "Assess the Owner's request for the basic living-room light using `/tmp/access/capability.pdf` and the actual SmartHome devices. If percentage dimming is not supported for that target, leave the requested basic light unchanged, do not substitute another living-room light, and reply to the Owner with the requested level and why it could not be applied.",
  "devices": [
    {
      "id": "linux_0",
      "type": "linux"
    },
    {
      "id": "android_0",
      "type": "android"
    },
    {
      "id": "home_0",
      "type": "home"
    }
  ],
  "setup": [
    {
      "device_id": "linux_0",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "mkdir -p /tmp/access",
            "shell": true
          }
        },
        {
          "type": "upload_file",
          "parameters": {
            "files": [
              {
                "local_path": "${repo_root}/tasks/cross_device/linux_android_smarthome_assets/linux_android_smarthome_185/source/tmp/access/capability.pdf",
                "path": "/tmp/access/capability.pdf"
              }
            ]
          }
        },
        {
          "type": "execute",
          "parameters": {
            "command": "nohup evince '/tmp/access/capability.pdf' >'/tmp/access/capability-evince.log' 2>&1 </dev/null &",
            "shell": true
          }
        }
      ]
    },
    {
      "device_id": "android_0",
      "config": [
        {
          "type": "ensure_app",
          "parameters": {
            "app": "simple sms messenger"
          }
        },
