          "type": "androidworld_sms_clear",
          "parameters": {}
        },
        {
          "type": "androidworld_sms_receive",
          "parameters": {
            "address": "+1555018501",
            "body": "Approved request: set the basic living room light to 35%.",
            "wait_s": 5.0
          }
        },
        {
          "type": "androidworld_sms_message_preflight",
          "parameters": {
            "message": {
              "address": "+1555018501",
              "body": "Approved request: set the basic living room light to 35%.",
              "box": "inbox"
            },
            "required_visible_text": [
              "Approved request: set the basic living room light to 35%."
            ]
          }
        },
        {
          "type": "ensure_app",
          "parameters": {
            "app": "contacts"
          }
        },
        {
          "type": "androidworld_contacts_clear",
          "parameters": {}
        },
        {
          "type": "androidworld_contact_add",
          "parameters": {
            "name": "Rachel Morgan",
            "number": "+1555018501",
            "notes": "Role: Owner"
          }
        },
        {
          "type": "androidworld_contact_preflight",
          "parameters": {
            "contact": {
              "name": "Rachel Morgan",
              "number": "+1555018501",
              "notes_exact": "Role: Owner"
            },
            "required_visible_text": [
              "Rachel Morgan",
              "Role: Owner"
            ]
          }
        }
      ]
    },
    {
      "device_id": "home_0",
      "config": [
        {
          "type": "smarthome.reset",
          "parameters": {
            "episode_config_ref": "tasks/cross_device/linux_android_smarthome_assets/linux_android_smarthome_185/episode_config.json"
          }
        }
      ]
    }
  ],
  "cleanup": [
    {
      "device_id": "linux_0",
      "config": [
        {
          "type": "execute",
          "parameters": {
            "command": "rm -f /tmp/access/capability.pdf /tmp/access/capability-evince.log; rmdir /tmp/access 2>/dev/null || true",
