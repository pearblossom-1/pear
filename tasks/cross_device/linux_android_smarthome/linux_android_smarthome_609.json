          }
        },
        {
          "type": "androidworld_sms_clear",
          "parameters": {}
        },
        {
          "type": "androidworld_sms_receive",
          "parameters": {
            "address": "+1555060901",
            "body": "Owner update: guest arrives 19:40; use the usual 20-minute guest room prep.",
            "wait_s": 5.0
          }
        },
        {
          "type": "androidworld_sms_message_preflight",
          "parameters": {
            "message": {
              "address": "+1555060901",
              "body": "Owner update: guest arrives 19:40; use the usual 20-minute guest room prep.",
              "box": "inbox"
            },
            "required_visible_text": [
              "Owner update",
              "19:40",
              "20-minute guest room prep"
            ]
          }
        },
        {
          "type": "ensure_app",
          "parameters": {
            "app": "contacts"
          }
        },
        {
          "type": "androidworld_contacts_clear",
          "parameters": {}
        },
        {
          "type": "androidworld_contact_add",
          "parameters": {
            "name": "Owner",
            "number": "+1555060901",
