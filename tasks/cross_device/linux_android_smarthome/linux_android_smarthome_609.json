            "end_ts": 1781638200,
            "location": "Guest room",
            "description": "Old arrival time; confirm against Owner message."
          }
        },
        {
          "type": "androidworld_calendar_event_preflight",
          "parameters": {
            "title": "Guest arrival",
            "start_ts": 1781636400,
