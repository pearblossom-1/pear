            "(?is)(?:\\bold\\b(?=[^.!?]{0,140}\\bprep(?:aration)?\\b)(?=[^.!?]{0,140}(?:18:40|6:40\\s*PM))[^.!?]{0,180}\\b(?:new|revised|replacement|updated)\\b(?=[^.!?]{0,140}\\bprep(?:aration)?\\b)(?=[^.!?]{0,140}(?:19:20|7:20\\s*PM))|\\bprep(?:aration)?\\b[^.!?]{0,80}(?:18:40|6:40\\s*PM)\\s*(?:→|->|to)\\s*(?:19:20|7:20\\s*PM))"
          ]
        }
      },
      "expected": {
        "type": "rule",
        "rules": {
          "expected": "present"
        }
