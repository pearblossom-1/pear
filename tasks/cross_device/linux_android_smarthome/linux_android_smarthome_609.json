      "device_id": "android_1",
      "func": "exact_match",
      "result": {
        "type": "androidworld_sms_message",
        "box": "sent",
        "address": "+1555060901",
        "recent_within_mins": 30,
        "body_relation": {
          "entities": [
            [
              "18:40",
              "6:40 PM",
              "6:40PM"
            ],
            [
              "19:00",
              "7:00 PM",
              "7:00PM"
            ],
            [
